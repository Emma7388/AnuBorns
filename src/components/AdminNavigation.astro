---
const normalizePath = (value) => {
  const normalized = String(value ?? "").replace(/\/+$/, "");
  return normalized || "/";
};

const currentPath = normalizePath(Astro.url.pathname);
const sections = [
  { href: "/admin/", path: "/admin", label: "Panel" },
  { href: "/admin/usuarios", path: "/admin/usuarios", label: "Usuarios" },
  { href: "/admin/operaciones", path: "/admin/operaciones", label: "Operaciones" },
  { href: "/admin/mercadopago", path: "/admin/mercadopago", label: "Mercado Pago" },
  { href: "/admin/administracion", path: "/admin/administracion", label: "Fee" },
];
---

<div class="ab-admin-shell">
  <aside class="ab-admin-navigation" aria-label="Secciones administrativas">
    <div class="ab-admin-navigation__heading">
      <span>Panel interno</span>
      <strong>Administración</strong>
    </div>
    <nav class="ab-admin-navigation__links">
      {sections.map((section) => {
        const isCurrent = currentPath === section.path;
        return (
          <a
            class:list={["ab-admin-navigation__link", { "is-current": isCurrent }]}
            href={section.href}
            aria-current={isCurrent ? "page" : undefined}
            data-astro-reload
          >
            <span>{section.label}</span>
          </a>
        );
      })}
    </nav>
  </aside>
  <div class="ab-admin-shell__content">
    <slot />
  </div>
</div>
