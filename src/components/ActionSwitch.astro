---
const {
  mode = "buy",
  categories = [],
  showServices = true,
} = Astro.props;

const isBuy = mode === "buy";
const isSell = mode === "sell";
---

<section class:list={["ab-buy-switch", isSell && "ab-buy-switch--sell"]} data-buy-switch>
  <div class="ab-buy-switch__row">
    <div class="ab-buy-switch__item">
      {
        isBuy ? (
          <button
            class="ab-buy-switch__trigger ab-buy-switch__trigger--products"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            data-buy-switch-trigger
          >
            Productos
            <span class="ab-buy-switch__dot ab-is-hidden" data-products-dot aria-hidden="true"></span>
          </button>
        ) : (
          <a class="ab-buy-switch__trigger ab-buy-switch__trigger--products" href="/vender/productos">
            Productos
          </a>
        )
      }
    </div>

    {
      !isBuy && showServices && (
        <div class="ab-buy-switch__item">
          <a class="ab-buy-switch__trigger ab-buy-switch__trigger--services" href="/vender/servicios">
            Servicios
          </a>
        </div>
      )
    }
  </div>
  {
    isBuy && (
      <div class="ab-buy-switch__menu" role="menu" aria-label="Categorías de productos" data-buy-switch-menu>
        {categories.map((category, index) => (
          <a
            class={`ab-buy-switch__menu-item ab-buy-switch__menu-item--${(index % 4) + 1}`}
            href={`/comprar/productos/${category.slug}`}
            data-category-slug={category.slug}
            role="menuitem"
          >
            {category.icon && (
              <img
                class="ab-buy-switch__menu-icon"
                src={category.icon}
                alt=""
                loading="lazy"
                aria-hidden="true"
              />
            )}
            <span class="ab-buy-switch__menu-label">{category.name}</span>
            <span class="ab-buy-switch__dot ab-buy-switch__dot--menu ab-is-hidden" data-category-dot={category.slug} aria-hidden="true"></span>
          </a>
        ))}
      </div>
    )
  }
</section>

<style>
  .ab-buy-switch {
    position: relative;
    width: 100%;
    padding: 8px 0 0;
  }

  .ab-buy-switch__row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 30px);
    width: 100%;
  }

  .ab-buy-switch--sell .ab-buy-switch__row {
    justify-content: center;
  }

  .ab-buy-switch__item {
    position: static;
    padding-bottom: 8px;
    margin-bottom: -8px;
  }

  .ab-buy-switch__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 118px;
    padding: 8px 12px;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    color: var(--color-text);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-panel-tint);
    font-family: inherit;
    cursor: pointer;
  }

  .ab-buy-switch__trigger--products,
  .ab-buy-switch__trigger--services {
    width: clamp(300px, 28vw, 360px);
    min-height: 78px;
    padding: 14px 28px;
    border-radius: 12px;
    color: #ffffff;
    border: 1px solid var(--button-elevated-border);
    font-size: clamp(1.8rem, 3.2vw, 2.65rem);
    font-weight: 850;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    overflow-wrap: anywhere;
    text-shadow: var(--button-elevated-text-shadow);
    box-shadow: var(--button-elevated-shadow);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      filter 0.18s ease;
  }

  .ab-buy-switch__trigger--products {
    background: var(--action-secondary);
  }

  .ab-buy-switch__trigger--services {
    background: var(--action-primary);
  }

  .ab-buy-switch__trigger--products:hover,
  .ab-buy-switch__trigger--services:hover,
  .ab-buy-switch__trigger--products:focus-visible,
  .ab-buy-switch__trigger--services:focus-visible {
    filter: brightness(1.04);
    transform: translateY(-2px);
    box-shadow: var(--button-elevated-shadow-hover);
  }

  .ab-buy-switch__menu {
    position: static;
    width: min(760px, calc(100vw - 24px));
    min-width: 0;
    max-height: 0;
    margin: 0 auto;
    overflow: hidden;
    overscroll-behavior: contain;
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 12px;
    padding: 0 12px;
    border-radius: 16px;
    border: 1px solid transparent;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: none;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 30;
    transform-origin: top center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      max-height 0.24s cubic-bezier(0.2, 0.9, 0.2, 1),
      margin-top 0.18s ease,
      padding-block 0.18s ease,
      opacity 0.16s ease,
      visibility 0s linear 0.24s;
  }

  .ab-buy-switch.is-open .ab-buy-switch__menu {
    max-height: 1600px;
    margin-top: 12px;
    overflow: visible;
    padding: 12px;
    border-color: var(--color-border-subtle);
    box-shadow: 0 18px 38px var(--color-shadow-strong);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
    animation: ab-products-menu-open 0.24s cubic-bezier(0.2, 0.9, 0.2, 1) both;
  }

  @keyframes ab-products-menu-open {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(0.94);
      filter: blur(4px);
    }
    60% {
      opacity: 1;
      transform: translateY(3px) scale(1.01);
      filter: blur(0);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .ab-buy-switch__menu::-webkit-scrollbar {
    width: 6px;
  }

  .ab-buy-switch__menu::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
  }

  .ab-buy-switch__menu::-webkit-scrollbar-thumb {
    background: rgba(22, 199, 132, 0.62);
    border-radius: 999px;
  }

  .ab-buy-switch__menu-item {
    position: relative;
    min-height: 68px;
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5px;
    text-decoration: none;
    color: #ffffff;
    font-weight: 800;
    text-align: center;
    line-height: 1.08;
    padding: 7px 6px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -12px 20px rgba(0, 0, 0, 0.1),
      0 7px 14px rgba(24, 76, 93, 0.22);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      filter 0.16s ease;
  }

  .ab-buy-switch__menu-item--1,
  .ab-buy-switch__menu-item--3 {
    background: var(--action-success);
  }

  .ab-buy-switch__menu-item--2 {
    background: var(--action-secondary);
  }

  .ab-buy-switch__menu-item--4 {
    background: var(--action-primary);
  }

  .ab-buy-switch__menu-icon {
    width: 47px;
    height: 47px;
    flex: 0 0 47px;
    object-fit: contain;
    filter: drop-shadow(0 4px 5px rgba(0, 0, 0, 0.22));
  }

  .ab-buy-switch__menu-label {
    min-width: 0;
    font-size: 1.38rem;
    font-weight: 850;
    max-width: 100%;
    line-height: 1.05;
    overflow: hidden;
    overflow-wrap: anywhere;
    hyphens: auto;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ab-buy-switch__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #22c55e;
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
    flex: 0 0 auto;
  }

  .ab-buy-switch__dot--menu {
    position: absolute;
    top: 10px;
    right: 10px;
    border-color: rgba(255, 255, 255, 0.76);
  }

  .ab-buy-switch__menu-item:hover,
  .ab-buy-switch__menu-item:focus-visible {
    filter: brightness(1.04);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      inset 0 -12px 20px rgba(0, 0, 0, 0.1),
      0 12px 22px rgba(24, 76, 93, 0.28);
  }

  @media (max-width: 768px) {
    .ab-buy-switch__row {
      gap: 14px;
    }

    .ab-buy-switch__item {
      flex: 0 1 min(310px, 100%);
      min-width: 0;
    }

    .ab-buy-switch__trigger {
      min-width: 0;
    }

    .ab-buy-switch__trigger--products,
    .ab-buy-switch__trigger--services {
      width: min(310px, 100%);
      min-height: 64px;
      font-size: clamp(1.55rem, 8vw, 2.2rem);
    }

    .ab-buy-switch__menu {
      width: min(360px, calc(100vw - 24px));
      min-width: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding-inline: 10px;
    }

    .ab-buy-switch.is-open .ab-buy-switch__menu {
      max-height: 1600px;
      overflow: visible;
      padding-block: 10px;
    }

    .ab-buy-switch__menu-item {
      min-height: 68px;
      padding: 7px 6px;
    }

    .ab-buy-switch__menu-icon {
      width: 47px;
      height: 47px;
      flex-basis: 47px;
    }

    .ab-buy-switch__menu-label {
      font-size: 1.18rem;
    }
  }

  @media (max-width: 560px) {
    .ab-buy-switch__menu-item {
      min-height: 117px;
      gap: 5px;
      padding: 14px 10px;
    }

    .ab-buy-switch__menu-icon {
      width: 78px;
      height: 78px;
      flex-basis: 78px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ab-buy-switch__menu {
      animation: none !important;
    }

    .ab-buy-switch__menu-item {
      transition: none;
    }
  }
</style>

<script>
  import "../scripts/action-switch.js";
  import "../scripts/product-category-notifications.js";
</script>
