---
const {
  mode = "buy",
  categories = [],
} = Astro.props;

const isBuy = mode === "buy";
const isSell = mode === "sell";
---

<section class:list={["ab-buy-switch", isSell && "ab-buy-switch--sell"]}>
  <div class="ab-buy-switch__row">
    <div class="ab-buy-switch__item">
      {
        isBuy ? (
          <>
            <button class="ab-buy-switch__trigger" type="button" aria-haspopup="true" aria-expanded="false">
              Productos
              <span class="ab-buy-switch__dot ab-is-hidden" data-products-dot aria-hidden="true"></span>
            </button>
            <div class="ab-buy-switch__menu" role="menu" aria-label="Categorías de productos">
              {categories.map((category) => (
                <a
                  class="ab-buy-switch__menu-item"
                  href={`/comprar/productos/${category.slug}`}
                  data-category-slug={category.slug}
                  role="menuitem"
                >
                  <span class="ab-buy-switch__menu-label">{category.name}</span>
                  <span class="ab-buy-switch__dot ab-buy-switch__dot--menu ab-is-hidden" data-category-dot={category.slug} aria-hidden="true"></span>
                </a>
              ))}
            </div>
          </>
        ) : (
          <a class="ab-buy-switch__trigger" href="/vender/productos">
            Productos
          </a>
        )
      }
    </div>

    <div class="ab-buy-switch__item">
      <a class="ab-buy-switch__trigger" href={isBuy ? "/comprar/servicios" : "/vender/servicios"}>
        Servicios
      </a>
    </div>
  </div>
</section>

<style>
  .ab-buy-switch {
    padding: 8px 0 0;
  }

  .ab-buy-switch__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ab-buy-switch--sell .ab-buy-switch__row {
    justify-content: center;
  }

  .ab-buy-switch__item {
    position: relative;
    padding-bottom: 8px;
    margin-bottom: -8px;
  }

  .ab-buy-switch__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 118px;
    padding: 8px 12px;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    color: var(--color-text);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-panel-tint);
    font-family: inherit;
    cursor: pointer;
  }

  .ab-buy-switch__menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    display: none;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    box-shadow: 0 14px 34px var(--color-shadow-strong);
    z-index: 30;
  }

  .ab-buy-switch__item:hover .ab-buy-switch__menu,
  .ab-buy-switch__item:focus-within .ab-buy-switch__menu {
    display: grid;
  }

  .ab-buy-switch__menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    padding: 8px 10px;
    border-radius: 8px;
  }

  .ab-buy-switch__menu-label {
    min-width: 0;
  }

  .ab-buy-switch__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #22c55e;
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
    flex: 0 0 auto;
  }

  .ab-buy-switch__dot--menu {
    border-color: var(--color-surface);
  }

  .ab-buy-switch__menu-item:hover,
  .ab-buy-switch__menu-item:focus-visible {
    background: var(--color-panel-tint);
  }

  @media (max-width: 560px) {
    .ab-buy-switch__row {
      width: 100%;
      gap: 8px;
    }

    .ab-buy-switch__item {
      flex: 1;
      min-width: 0;
    }

    .ab-buy-switch__trigger {
      width: 100%;
      min-width: 0;
      padding: 8px 10px;
      font-size: 0.82rem;
    }

    .ab-buy-switch__menu {
      width: 100%;
      min-width: 0;
      max-height: 52vh;
      overflow: auto;
    }
  }
</style>

<script>
  import "../scripts/product-category-notifications.js";
</script>
