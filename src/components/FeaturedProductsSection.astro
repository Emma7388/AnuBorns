---
import { getFeaturedProducts } from "../lib/featuredProducts.js";
import TitleBadge from "./TitleBadge.astro";
import { getCurrentInternalPath, withReturnPath } from "../lib/internalNavigation.js";

const { title = "PRODUCTOS DESTACADOS", featured } = Astro.props;
const result = featured ?? await getFeaturedProducts();
const items = Array.isArray(result?.items) ? result.items : [];
const error = String(result?.error ?? "");
const isLoaded = error ? "false" : "true";
const currentPath = getCurrentInternalPath(Astro.url);

const formatPrice = (value) => {
  const safe = Number(value ?? 0);
  return safe.toLocaleString("es-AR");
};
const formatDate = (value) => {
  if (!value) return "Sin fecha";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "Sin fecha";
  return date.toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" });
};
const formatDelivery = (value) => {
  if (!Array.isArray(value) || value.length === 0) return "No especificada";
  const labels = value.map((item) => {
    if (item === "retiro") return "Retiro";
    if (item === "envio") return "Envío";
    return item;
  });
  return labels.join(" + ");
};

const getProductHref = (item) => {
  const productId = String(item?.productId ?? "").trim();
  const sellerUserId = String(item?.sellerUserId ?? "").trim();
  if (productId) return withReturnPath(`/producto/${encodeURIComponent(productId)}`, currentPath);
  if (sellerUserId) return withReturnPath(`/proveedor-publico/${encodeURIComponent(sellerUserId)}`, currentPath);
  return "#";
};

const getProviderHref = (item) => {
  const sellerUserId = String(item?.sellerUserId ?? "").trim();
  return sellerUserId ? withReturnPath(`/proveedor-publico/${encodeURIComponent(sellerUserId)}`, currentPath) : "#";
};

const serializeDelivery = (value) =>
  Array.isArray(value) ? value.map((item) => String(item ?? "").trim().toLowerCase()).filter(Boolean).join(",") : "";
---

<section
  class="ab-dark-panel ab-provider-products-panel ab-featured-products-panel"
  data-featured-products
  data-featured-loaded={isLoaded}
>
  <TitleBadge title={title} icon="/icons/destacado.svg" level={2} tone="warning" />
  <p class="ab-muted-text" data-featured-products-status>{error}</p>
  <div class="ab-featured-products-carousel" data-featured-products-carousel>
    <button
      type="button"
      class="ab-featured-products-nav ab-featured-products-nav--prev"
      aria-label="Ver producto destacado anterior"
      data-featured-products-prev
    >
      <img src="/icons/atras2.svg" alt="" aria-hidden="true" />
    </button>
    <div class="ab-provider-products-grid ab-featured-products-track" data-featured-products-grid>
      {items.map((item) => (
        <article
          class="ab-provider-product-card"
          data-user-id={item.sellerUserId}
          data-cart-id={item.productId}
          data-price={item.price}
          data-title={item.title}
          data-image={item.imageUrl}
          data-provider={item.sellerName}
          data-currency={item.currency}
          data-delivery={serializeDelivery(item.deliveryMethods)}
        >
          <a
            class="ab-featured-seller-link"
            href={getProviderHref(item)}
            aria-disabled={item.sellerUserId ? null : "true"}
          >
            <span>Vendedor: <strong>{item.sellerName || "Proveedor"}</strong></span>
          </a>
          <div class="ab-featured-product-body">
          <img
            class="ab-provider-product-card__image"
            src={item.imageUrl}
            alt={item.title || "Producto"}
            loading="lazy"
          />
          <div class="ab-category-product-heading">
            <h2>{item.title || "Producto"}</h2>
            <div class="ab-provider-product-card__meta">

            <p class="ab-provider-product-card__price">
              ${formatPrice(item.price)} <span>{item.currency || "ARS"}</span>
            </p>
          </div>

          </div>
          <p class="ab-provider-product-card__description"><strong>Detalle:</strong>
            {item.description || "Sin descripción"}
          </p>
          <ul class="ab-provider-product-card__details">
            <li>Fecha: <strong>{formatDate(item.createdAt)}</strong></li>
            <li>Ubicación: <strong>{item.location || "Sin especificar"}</strong></li>
            {item.pickupAddress ? (
              <li>Dirección: <strong>{item.pickupAddress}</strong></li>
            ) : null}
            <li>Entrega: <strong>{formatDelivery(item.deliveryMethods)}</strong></li>
          </ul>

          <div class="ab-provider-product-card__actions ab-provider-product-card__actions--split ab-featured-products-actions">
            <a
              class="ab-featured-products-detail"
              href={getProductHref(item)}
              aria-disabled={item.productId ? null : "true"}
            >
              <img src="/icons/detalle.svg" alt="" aria-hidden="true" />
              <span>Detalle</span>
            </a>
            <button
              type="button"
              class="ab-provider-product-card__add"
              aria-label="Enviar al carrito"
              title="Enviar al carrito"
            >
              <img src="/icons/carrito.svg" alt="" aria-hidden="true" />
              <span>Enviar al carrito</span>
            </button>
          </div>
          </div>
        </article>
      ))}
    </div>
    <button
      type="button"
      class="ab-featured-products-nav ab-featured-products-nav--next"
      aria-label="Ver siguiente producto destacado"
      data-featured-products-next
    >
      <img src="/icons/adelante.svg" alt="" aria-hidden="true" />
    </button>
  </div>
  <div class:list={["ab-cart-empty", { "ab-is-hidden": items.length > 0 || error }]} data-featured-products-empty>
    <p>Aún no hay productos destacados para mostrar.</p>
  </div>
</section>

<script>
  import "../scripts/comprar-productos.js";
  import "../scripts/featured-products.js";
</script>
