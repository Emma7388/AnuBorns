---
import { getFeaturedProducts } from "../lib/featuredProducts.js";

const { title = "PRODUCTOS DESTACADOS", featured } = Astro.props;
const result = featured ?? await getFeaturedProducts();
const items = Array.isArray(result?.items) ? result.items : [];
const error = String(result?.error ?? "");
const isLoaded = error ? "false" : "true";

const formatPrice = (value) => {
  const safe = Number(value ?? 0);
  return safe.toLocaleString("es-AR");
};

const getProductHref = (item) => {
  const productId = String(item?.productId ?? "").trim();
  const sellerUserId = String(item?.sellerUserId ?? "").trim();
  if (productId) return `/producto/${encodeURIComponent(productId)}`;
  if (sellerUserId) return `/proveedor-publico/${encodeURIComponent(sellerUserId)}`;
  return "#";
};

const serializeDelivery = (value) =>
  Array.isArray(value) ? value.map((item) => String(item ?? "").trim().toLowerCase()).filter(Boolean).join(",") : "";
---

<section
  class="ab-dark-panel ab-provider-products-panel"
  data-featured-products
  data-featured-loaded={isLoaded}
>
  <h2>{title}</h2>
  <p class="ab-muted-text" data-featured-products-status>{error}</p>
  <div class="ab-provider-products-grid" data-featured-products-grid>
    {items.map((item) => (
      <article
        class="ab-provider-product-card"
        data-user-id={item.sellerUserId}
        data-cart-id={item.productId}
        data-price={item.price}
        data-title={item.title}
        data-image={item.imageUrl}
        data-provider={item.sellerName}
        data-currency={item.currency}
        data-delivery={serializeDelivery(item.deliveryMethods)}
      >
        <a
          href={getProductHref(item)}
          class="ab-featured-card-link"
          aria-disabled={item.productId || item.sellerUserId ? null : "true"}
        >
          <img
            class="ab-provider-product-card__image"
            src={item.imageUrl}
            alt={item.title || "Producto"}
            loading="lazy"
          />
          <div class="ab-provider-product-card__meta">
            <div>
              <p class="ab-provider-product-card__label">Destacado</p>
              <p class="ab-provider-product-card__code">{item.sellerName || "Proveedor"}</p>
            </div>
            <p class="ab-provider-product-card__price">
              ${formatPrice(item.price)} <span>{item.currency || "ARS"}</span>
            </p>
          </div>
          <h2>{item.title || "Producto"}</h2>
          <p class="ab-provider-product-card__description">
            {item.description || "Sin descripción"}
          </p>
        </a>
        <button
          type="button"
          class="ab-provider-product-card__add"
          aria-label="Agregar al carrito"
          title="Agregar al carrito"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6l.7 3.2h11.7a1 1 0 0 1 1 .8l-1.1 5a1 1 0 0 1-1 .8H8.2a1 1 0 0 1-1-.8L5.1 5H3a1 1 0 1 1 0-2h2.9a1 1 0 0 1 1 .8L7.1 4H20a1 1 0 1 1 0 2H6.2z"
              fill="currentColor"
            ></path>
          </svg>
        </button>
      </article>
    ))}
  </div>
  <div class:list={["ab-cart-empty", { "ab-is-hidden": items.length > 0 || error }] } data-featured-products-empty>
    <p>Aún no hay productos destacados para mostrar.</p>
  </div>
</section>

<script>
  import "../scripts/comprar-productos.js";
  import "../scripts/featured-products.js";
</script>
