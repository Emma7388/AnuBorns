---
// Componente: footer con CTA opcional de regreso.
const { showBack = false, backHref = "/" } = Astro.props;
const useHistoryBack = backHref === "history";
const resolvedBackHref = useHistoryBack ? "/" : backHref;
---

<!-- Pie de página principal -->
<footer class="footer" transition:name="ab-footer" transition:persist transition:animate="none">
  <div class="container">
    <div class="footer-content">
      <p>© 2026 Desoluciones. Todos los derechos reservados.</p>
      <!-- Botón volver opcional -->
      <a
        id="footer-back"
        class="ab-cta-button footer-back"
        href={resolvedBackHref}
        data-ab-back={useHistoryBack ? "history" : "link"}
        aria-hidden={showBack ? "false" : "true"}
        tabindex={showBack ? "0" : "-1"}
        hidden={!showBack}
        aria-label="Volver"
        title="Volver"
      >
        <img src="/icons/atras.svg" alt="" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<style>
/* Layout y estilo del footer */
.footer {
  background: var(--color-surface);
  color: var(--color-text-muted);
  padding: 0;
  margin-top: 0;
  text-align: center;
  border-top: 1px solid var(--color-border-subtle);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  min-height: var(--footer-height);
  height: var(--footer-height);
  display: flex;
  align-items: center;
  position: sticky;
  bottom: 0;
  z-index: 40;
}

.footer-content {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 16px;
  width: 100%;
  min-height: calc(var(--footer-height) - 2px);
}

.footer-content p {
  grid-column: 1;
  margin: 0;
  font-size: clamp(0.78rem, 1.6dvh, 0.95rem);
  line-height: 1.2;
  text-align: left;
}

.footer-back {
  grid-column: 2;
  justify-self: center;
  width: clamp(48px, 5.8dvh, 58px);
  height: clamp(44px, 5.4dvh, 54px);
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.footer-back[hidden] {
  display: none;
}

.footer-back img {
  width: clamp(24px, 3dvh, 30px);
  height: clamp(24px, 3dvh, 30px);
  object-fit: contain;
}

/* Ajustes responsive */
@media (max-width: 720px) {
  .footer {
    padding: 0;
    background: var(--color-surface);
  }

  .footer-content {
    gap: 8px;
  }

  .footer-content p {
    min-width: 0;
    text-align: left;
    font-size: clamp(0.68rem, 1.4dvh, 0.82rem);
  }
}
</style>
