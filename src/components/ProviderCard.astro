---
// Componente: tarjeta resumida de proveedor.
const {
  name,
  ranking,
  average,
  location,
  sponsor = false,
  category,
  slug,
  profileBasePath = "/proveedor",
  productsBasePath = "/proveedor",
  fromPath,
  avatar = "/avatars/provider-default.svg",
  dailySold = 0,
} = Astro.props;

// Rutas con parámetro "from" para volver atrás.
const safeFromPath = fromPath ?? `/comprar/productos/${category}`;
const profileHref = `${profileBasePath}/${slug}?from=${encodeURIComponent(safeFromPath)}`;
const productsHref = `${productsBasePath}/${slug}/productos?from=${encodeURIComponent(safeFromPath)}`;
---
<!-- Card de proveedor -->
<div class="ab-provider-card">
  <!-- Badge de ranking -->
  {ranking <= 3 && (
    <div class="ab-provider-card__ranking-badge">
      ⭐ Ranking #{ranking}
    </div>
  )}

  <!-- Badge de sponsor -->
  {sponsor && <div class="ab-provider-card__sponsor-badge">SPONSOR</div>}

  <!-- Encabezado con avatar y nombre -->
  <div class="ab-provider-card__header">
    <span class="ab-provider-card__avatar">
      <img src={avatar} alt={`Avatar de ${name}`} loading="lazy" />
    </span>
    <h2 class="ab-provider-card__name">{name}</h2>
  </div>

  <p class="ab-provider-card__average">
    Promedio publicado: <strong>${average}</strong>
  </p>

  <p class="ab-provider-card__daily">
    Vendidos hoy: <strong>{dailySold}</strong>
  </p>

  <p class="ab-provider-card__location">{location}</p>

  <!-- CTAs principales -->
  <a
    href={productsHref}
    class="ab-cta-button"
  >
    Ver productos
  </a>
  <a href={profileHref} class="ab-cta-button">Ver perfil</a>

</div>

<style>
  .ab-provider-card {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 14px;
    border: var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    color: var(--color-text);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease;
  }

  .ab-provider-card:hover {
    border-color: var(--glass-green-border);
    background: var(--color-panel-tint-strong);
    box-shadow: var(--card-hover-shadow);
    transform: translateY(-2px);
  }

  .ab-provider-card:active {
    transform: translateY(1px);
  }

  .ab-provider-card__ranking-badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--glass-green-bg);
    border: 1px solid var(--glass-green-border);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-text);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .ab-provider-card__sponsor-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--chip-warning-bg);
    border: 1px solid var(--chip-warning-border);
    color: var(--chip-warning-text);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 850;
  }

  .ab-provider-card__name {
    margin: 0;
    font-size: 20px;
  }

  .ab-provider-card__average {
    margin: 0;
    color: var(--color-text-soft);
  }

  .ab-provider-card__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .ab-provider-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    background: var(--color-panel-tint-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ab-provider-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ab-provider-card__daily {
    margin: 0;
    color: var(--color-text-soft);
  }

  .ab-provider-card__location {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 0 0 4px;
  }

  .ab-provider-card :global(.ab-cta-button) {
    width: 100%;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-color: var(--button-elevated-border);
    background: var(--action-primary);
    color: #ffffff;
    border-radius: 12px;
    font-weight: 850;
    text-shadow: var(--button-elevated-text-shadow);
    box-shadow: var(--button-elevated-shadow);
  }

  .ab-provider-card :global(.ab-cta-button + .ab-cta-button) {
    background: var(--action-secondary);
  }

  .ab-provider-card :global(.ab-cta-button:hover),
  .ab-provider-card :global(.ab-cta-button:focus-visible) {
    color: #ffffff;
    filter: brightness(1.04);
    transform: translateY(-1px);
    box-shadow: var(--button-elevated-shadow-hover);
  }
</style>
