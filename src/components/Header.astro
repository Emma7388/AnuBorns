---
// Componente: header con auth, carrito y modal de logout.
const { title = "" } = Astro.props;
---

<header class="header" transition:name="ab-header" transition:persist transition:animate="none">
  <div class="container header-inner">
    <div class="brand-row header-zone header-zone--brand">
      <!-- Marca / logo -->
      <a href="/" class="logo" data-astro-reload aria-label="Ir al inicio">
        <img src="/Logo_Final.webp" alt="Desoluciones.com" />
      </a>
    </div>

    <!-- Título de página (inyectado desde MainLayout) -->
    <div id="ab-header-page-title" class="ab-header-page-title header-zone header-zone--title" aria-live="polite">
      {title && <h1><span>{title}</span></h1>}
    </div>

    <!-- Navegación superior -->
    <nav class="nav header-zone header-zone--nav">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        aria-pressed="false"
      >
        <span class="theme-toggle__icons" aria-hidden="true">
          <img class="theme-toggle__icon theme-toggle__icon--sun" src="/icons/claro.svg" alt="" />
          <img class="theme-toggle__icon theme-toggle__icon--moon" src="/icons/oscuro.svg" alt="" />
        </span>
        <span class="theme-toggle__label ab-is-hidden" data-theme-label aria-hidden="true"></span>
      </button>

      <!-- Acceso rápido al carrito -->
      <a class="nav-cart" href="/carrito" aria-label="Ir al carrito">
        <img src="/icons/carrito.svg" alt="" aria-hidden="true" />
        <span id="cart-count">0</span>
      </a>
      <span id="cart-sync" class="nav-cart-sync ab-is-hidden">Sincronizando</span>
      <!-- Estado: usuario invitado -->
      <div class="nav-auth nav-auth--guest ab-is-hidden" data-auth="guest">
        <a
          class="nav-login nav-login--ghost nav-login--icon"
          href="/login"
          aria-label="Iniciar sesión"
          title="Iniciar sesión"
        >
          <img src="/icons/iniciarsesion.svg" alt="" aria-hidden="true" />
          <span>Entrar</span>
        </a>
        <a
          class="nav-login nav-login--ghost nav-login--icon"
          href="/registro"
          aria-label="Registrarse"
          title="Registrarse"
        >
          <img src="/icons/registrar.svg" alt="" aria-hidden="true" />
          <span>Registro</span>
        </a>
      </div>
      <!-- Estado: usuario autenticado -->
      <div class="nav-auth nav-auth--user ab-is-hidden" data-auth="user">
        <div class="nav-profile">
          <a
            class="nav-avatar"
            href="/mis-datos"
            aria-label="Ir a mis datos"
          >
            <span id="sales-notification-dot" class="ab-sales-notification-dot ab-is-hidden" aria-hidden="true"></span>
            <img id="auth-avatar" alt="Avatar de usuario" />
          </a>
          <span class="nav-user nav-user--plain" id="auth-name"></span>
        </div>
        <button
          class="nav-login nav-login--ghost nav-login--icon nav-logout"
          type="button"
          id="auth-logout"
          aria-label="Salir"
          title="Salir"
        >
          <img src="/icons/salir.svg" alt="" aria-hidden="true" />
          <span>Salir</span>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Modal de confirmación para cerrar sesión -->
<div class="ab-modal ab-is-hidden" id="logout-modal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="ab-modal__backdrop" data-modal-close></div>
  <div class="ab-modal__panel" role="document" aria-labelledby="logout-title">
    <h2 id="logout-title">Cerrar sesión</h2>
    <p>¿Estás seguro de que querés cerrar sesión?</p>
    <div class="ab-modal__actions">
      <button type="button" class="ab-orders-delete-btn ab-orders-delete-btn--ghost" data-modal-cancel>
        Cancelar
      </button>
      <button type="button" class="ab-orders-delete-btn" data-modal-confirm>
        Sí, salir
      </button>
    </div>
  </div>
</div>

<style>
/* Layout general del header */
.header {
  --header-block-padding: clamp(8px, 1.4dvh, 14px);
  background: var(--color-surface);
  color: var(--color-text);
  min-height: var(--header-height);
  height: var(--header-height);
  box-sizing: border-box;
  padding: var(--header-block-padding) 0;
  border-bottom: 1px solid var(--color-border-subtle);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 50;
}

.header-inner {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  text-align-last: right;
  column-gap: clamp(2px, 0.45vw, 6px);
  width: 100%;
  max-width: none;
  margin: 0;
  padding-inline: clamp(10px, 2.2vw, 28px);
}

.header-zone {
  min-width: 0;
}

.header-zone--brand {
  grid-column: 1;
}

.header-zone--title {
  grid-column: 2;
}

.header-zone--nav {
  grid-column: 3;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  justify-content: flex-start;
  align-self: stretch;
}

.ab-header-page-title {
  min-width: 0;
  text-align: right;
  justify-self: stretch;
  width: 100%;
  height: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.ab-header-page-title:empty {
  visibility: hidden;
}

.ab-header-page-title :global(h1) {
  position: relative;
  margin: 0;
  display: inline-block;
  padding: 0 6px 7px 2px;
  font-size: clamp(1.35rem, 2.8vw, 2.25rem);
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.02;
  max-width: 100%;
  max-height: calc(100% - 2px);
  overflow: hidden;
  overflow-wrap: anywhere;
  text-wrap: balance;
}

.ab-header-page-title :global(h1)::after {
  content: "";
  position: absolute;
  right: 6px;
  bottom: 0;
  width: min(82%, 260px);
  height: 5px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(72, 186, 161, 0.15), #48baa1 24%, #229478 100%);
  box-shadow: 0 3px 8px rgba(34, 148, 120, 0.34);
}

.logo {
  position: relative;
  text-decoration: none;
  flex: 0 0 auto;
  width: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  height: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.logo::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: var(--hero-logo-bg);
  z-index: 0;
}

.logo img {
  position: relative;
  z-index: 1;
  width: auto;
  height: 88%;
  object-fit: contain;
  object-position: center;
  display: block;
  max-width: 100%;
}

.nav {
  display: flex;
  align-items: center;
  gap: clamp(10px, 1.2vw, 14px);
  justify-content: flex-end;
  flex-wrap: nowrap;
  justify-self: end;
  min-width: 0;
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  width: 50px;
  height: 50px;
  padding: 0;
  border-radius: 999px;
  border: 1px solid var(--color-border-subtle);
  background: transparent;
  color: var(--color-text);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  box-shadow: none;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease,
    box-shadow 0.2s ease;
}

.theme-toggle:hover,
.theme-toggle:focus-visible {
  border-color: var(--glass-green-border);
  background: transparent;
  box-shadow: 0 14px 24px rgba(22, 199, 132, 0.18);
  transform: translateY(-1px);
}

.theme-toggle__icons {
  position: relative;
  width: 26px;
  height: 26px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.theme-toggle__icon {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.theme-toggle__icon--moon {
  opacity: 1;
  transform: scale(1);
}

:global(:root[data-theme="dark"]) .theme-toggle__icon--moon {
  opacity: 0;
  transform: scale(0.8);
}

:global(:root[data-theme="dark"]) .theme-toggle__icon--sun {
  opacity: 1;
  transform: scale(1);
}

.nav-auth {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  justify-content: flex-end;
}

.nav-auth--guest {
  gap: 10px;
}

.nav-auth--user {
  gap: 10px;
}

.nav-login {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 0.6rem 1.2rem;
  border-radius: 999px;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  font: inherit;
  white-space: nowrap;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  box-shadow: 0 10px 20px rgba(22, 199, 132, 0.25);
}

.nav-login--icon {
  width: 56px;
  height: 52px;
  padding: 0;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 1px;
}

.nav-login svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.nav-login img {
  width: 27px;
  height: 27px;
  object-fit: contain;
}

.nav-login--icon span {
  font-size: 9px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0;
}

.nav-logout {
  color: var(--color-text);
}

.nav-login:hover,
.nav-login:focus-visible {
  box-shadow: 0 14px 24px rgba(22, 199, 132, 0.3);
  transform: translateY(-1px);
}

.nav-login:active {
  transform: translateY(1px);
}

.nav-login--ghost {
  background: transparent;
  border: 1px solid var(--color-border-subtle);
  color: var(--color-text);
  font-weight: 600;
  box-shadow: none;
}

.nav-login--ghost:hover,
.nav-login--ghost:focus-visible {
  color: var(--color-text);
  border-color: var(--color-accent);
}

.nav-login--ghost:active {
  transform: translateY(1px);
}

.nav-user {
  font-weight: 600;
  color: var(--color-text);
  padding: 0.4rem 0.8rem;
  border-radius: 999px;
  background: var(--color-panel-tint);
  border: 1px solid var(--color-panel-tint-strong);
}

.nav-profile {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
  min-width: 50px;
}

.nav-user--plain {
  max-width: 54px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 9px;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Modal: estilos y animaciones */
.ab-modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 120;
}

.ab-modal:not(.ab-is-hidden) {
  animation: ab-modal-fade 0.18s ease;
}

.ab-modal__backdrop {
  position: absolute;
  inset: 0;
  background: var(--color-modal-backdrop);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.ab-modal__panel {
  position: relative;
  z-index: 1;
  width: min(92vw, 420px);
  padding: 20px;
  border-radius: 16px;
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 18px 40px var(--color-shadow-strong);
  display: grid;
  gap: 12px;
}

.ab-modal:not(.ab-is-hidden) .ab-modal__panel {
  animation: ab-modal-pop 0.2s ease;
}

.ab-modal__panel h2 {
  margin: 0;
  text-align: left;
}

.ab-modal__panel p {
  margin: 0;
  color: var(--color-text-muted);
}

.ab-modal__actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

@keyframes ab-modal-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ab-modal-pop {
  from {
    transform: translateY(6px);
    opacity: 0.9;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ab-modal:not(.ab-is-hidden),
  .ab-modal:not(.ab-is-hidden) .ab-modal__panel {
    animation: none;
  }
}

/* Avatar de usuario */
.nav-avatar {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: 999px;
  border: 1px solid var(--color-border-soft);
  background: var(--color-panel-tint);
  display: grid;
  place-items: center;
  overflow: visible;
}

.ab-sales-notification-dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #22c55e;
  border: 2px solid var(--color-bg);
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
  z-index: 2;
}

.nav-cart {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  width: 50px;
  height: 50px;
  border-radius: 999px;
  border: 1px solid var(--color-border-subtle);
  background: transparent;
  color: var(--color-text);
  font-weight: 700;
  text-decoration: none;
  position: relative;
  flex: 0 0 auto;
  transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease,
    transform 0.2s ease;
}

.nav-cart:hover,
.nav-cart:focus-visible {
  background: transparent;
  border-color: var(--color-accent);
  box-shadow: 0 14px 24px rgba(22, 199, 132, 0.18);
  transform: translateY(-1px);
}

.nav-cart img {
  width: 29px;
  height: 29px;
  object-fit: contain;
}

.nav-cart span {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--color-accent);
  color: var(--color-on-accent);
  border-radius: 999px;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  line-height: 1;
  border: 2px solid var(--color-surface);
}

.nav-cart-sync {
  font-size: 11px;
  color: var(--color-text);
  background: var(--color-panel-tint-strong);
  border: 1px solid var(--color-border-subtle);
  border-radius: 999px;
  padding: 4px 8px;
}

.nav-avatar img {
  width: 100%;
  height: 100%;
  border-radius: 999px;
  object-fit: cover;
  display: none;
}

@media (max-width: 720px) {
  .header {
    --header-block-padding: clamp(7px, 1.2dvh, 10px);
  }

  .header-inner {
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: 2px;
    padding-inline: 8px;
  }

  .brand-row {
    gap: 8px;
  }

  .logo {
    width: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  }

  .logo img {
    width: auto;
    height: 100%;
  }

  .ab-header-page-title :global(h1) {
    margin: 0;
    text-align: right;
    padding: 0 3px 6px 1px;
    font-size: clamp(1.22rem, 5.3vw, 1.78rem);
    line-height: 1.02;
  }

  .nav {
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    row-gap: 0;
  }

  .nav-auth,
  .nav-auth--guest,
  .nav-auth--user {
    justify-content: flex-end;
    gap: 6px;
  }

  .theme-toggle,
  .nav-cart {
    width: 44px;
    height: 44px;
    min-height: 44px;
  }

  .nav-login--icon {
    width: 48px;
    height: 44px;
  }

  .nav-login img {
    width: 23px;
    height: 23px;
  }

  .nav-login--icon span {
    font-size: 8px;
  }

  .nav-cart-sync {
    display: none;
  }
}

@media (max-width: 420px) {
  .header-inner {
    column-gap: 1px;
  }

  .logo {
    width: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  }

  .logo img {
    width: auto;
    height: 100%;
  }

  .ab-header-page-title :global(h1) {
    padding: 0 2px 6px 0;
    font-size: clamp(1.1rem, 4.1vw, 1.45rem);
  }

  .nav-login,
  .nav-login--ghost,
  .nav-cart,
  .theme-toggle {
    justify-content: center;
    text-align: center;
  }
}

@media (max-width: 380px) {
  .brand-row,
  .nav,
  .nav-auth,
  .nav-auth--guest,
  .nav-auth--user {
    gap: 5px;
  }

  .ab-header-page-title :global(h1) {
    padding: 0 2px 6px 0;
    font-size: clamp(0.8rem, 4.1vw, 0.45rem);
  }

  .logo {
    width: calc(var(--header-height) - var(--header-block-padding) - var(--header-block-padding));
  }

  .logo img {
    width: auto;
    height: 100%;
  }

  .nav-cart,
  .theme-toggle {
    width: 40px;
    height: 40px;
    min-height: 40px;
  }

  .nav-login--icon {
    width: 42px;
    height: 40px;
  }

  .nav-login img {
    width: 21px;
    height: 21px;
  }

  .nav-login--icon span {
    font-size: 7px;
  }
}
</style>

<script>
  import "../scripts/header-auth.js";
  import "../scripts/theme.js";
</script>
