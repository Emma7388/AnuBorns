---
// Componente: header con auth, carrito y modal de logout.
const { title = "" } = Astro.props;
---

<header class="header" transition:name="ab-header" transition:persist transition:animate="none">
  <div class="container header-inner">
    <div class="brand-row">
      <!-- Marca / logo -->
      <a href="/" class="logo">Desoluciones</a>

      <!-- Título de página (inyectado desde MainLayout) -->
      <div id="ab-header-page-title" class="ab-header-page-title" aria-live="polite">
        {title && <h1>{title}</h1>}
      </div>
    </div>

    <!-- Navegación superior -->
    <nav class="nav">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        aria-pressed="false"
      >
        <span class="theme-toggle__icons" aria-hidden="true">
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" focusable="false">
            <path
              d="M12 4.5a1 1 0 0 1 1 1v1.1a1 1 0 1 1-2 0V5.5a1 1 0 0 1 1-1zm0 12.9a1 1 0 0 1 1 1v1.1a1 1 0 1 1-2 0v-1.1a1 1 0 0 1 1-1zM6.7 6.1a1 1 0 0 1 1.4 0l.8.8A1 1 0 1 1 7.5 8.3l-.8-.8a1 1 0 0 1 0-1.4zm8.4 8.4a1 1 0 0 1 1.4 0l.8.8a1 1 0 0 1-1.4 1.4l-.8-.8a1 1 0 0 1 0-1.4zM4.5 12a1 1 0 0 1 1-1h1.1a1 1 0 1 1 0 2H5.5a1 1 0 0 1-1-1zm12.9 0a1 1 0 0 1 1-1h1.1a1 1 0 1 1 0 2h-1.1a1 1 0 0 1-1-1zM6.7 17.9a1 1 0 0 1 0-1.4l.8-.8a1 1 0 0 1 1.4 1.4l-.8.8a1 1 0 0 1-1.4 0zm8.4-8.4a1 1 0 0 1 0-1.4l.8-.8a1 1 0 1 1 1.4 1.4l-.8.8a1 1 0 0 1-1.4 0zM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z"
              fill="currentColor"
            ></path>
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" focusable="false">
            <path
              d="M14.6 3.2a1 1 0 0 1 .9 1.5 7.3 7.3 0 0 0 8.8 10.6 1 1 0 0 1 1.3 1.2A10 10 0 1 1 13.4 2a1 1 0 0 1 1.2 1.2z"
              fill="currentColor"
            ></path>
          </svg>
        </span>
        <span class="theme-toggle__label ab-is-hidden" data-theme-label aria-hidden="true"></span>
      </button>

      <!-- Acceso rápido al carrito -->
      <a class="nav-cart" href="/carrito" aria-label="Ir al carrito">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6l.7 3.2h11.7a1 1 0 0 1 1 .8l-1.1 5a1 1 0 0 1-1 .8H8.2a1 1 0 0 1-1-.8L5.1 5H3a1 1 0 1 1 0-2h2.9a1 1 0 0 1 1 .8L7.1 4H20a1 1 0 1 1 0 2H6.2z"
            fill="currentColor"
          ></path>
        </svg>
        <span id="cart-count">0</span>
      </a>
      <span id="cart-sync" class="nav-cart-sync ab-is-hidden">Sincronizando</span>
      <!-- Estado: usuario invitado -->
      <div class="nav-auth nav-auth--guest ab-is-hidden" data-auth="guest">
        <a class="nav-login nav-login--icon" href="/login" aria-label="Iniciar sesión" title="Iniciar sesión">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M10 7V5.8A2.8 2.8 0 0 1 12.8 3h5.4A2.8 2.8 0 0 1 21 5.8v12.4a2.8 2.8 0 0 1-2.8 2.8h-5.4A2.8 2.8 0 0 1 10 18.2V17" />
            <path d="M3 12h11" />
            <path d="m11 8 4 4-4 4" />
          </svg>
          <span>Entrar</span>
        </a>
        <a
          class="nav-login nav-login--ghost nav-login--icon"
          href="/registro"
          aria-label="Registrarse"
          title="Registrarse"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 20a6 6 0 0 0-12 0" />
            <path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" />
            <path d="M19 8v6" />
            <path d="M16 11h6" />
          </svg>
          <span>Registro</span>
        </a>
      </div>
      <!-- Estado: usuario autenticado -->
      <div class="nav-auth nav-auth--user ab-is-hidden" data-auth="user">
        <span class="nav-user nav-user--plain" id="auth-name"></span>
        <a
          class="nav-avatar"
          href="/mis-datos"
          aria-label="Ir a mis datos"
          data-ab-profile-link
        >
          <span id="sales-notification-dot" class="ab-sales-notification-dot ab-is-hidden" aria-hidden="true"></span>
          <img id="auth-avatar" alt="Avatar de usuario" />
        </a>
        <button class="nav-login nav-login--ghost" type="button" id="auth-logout">Salir</button>
      </div>
    </nav>
  </div>
</header>

<!-- Modal de confirmación para cerrar sesión -->
<div class="ab-modal ab-is-hidden" id="logout-modal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="ab-modal__backdrop" data-modal-close></div>
  <div class="ab-modal__panel" role="document" aria-labelledby="logout-title">
    <h2 id="logout-title">Cerrar sesión</h2>
    <p>¿Estás seguro de que querés cerrar sesión?</p>
    <div class="ab-modal__actions">
      <button type="button" class="nav-login nav-login--ghost" data-modal-cancel>
        Cancelar
      </button>
      <button type="button" class="nav-login" data-modal-confirm>
        Sí, salir
      </button>
    </div>
  </div>
</div>

<style>
/* Layout general del header */
.header {
  background: var(--color-surface);
  color: var(--color-text);
  padding: 1rem 0;
  border-bottom: 1px solid var(--color-border-subtle);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 50;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1 1 auto;
  justify-content: space-evenly;
}

.ab-header-page-title {
  min-width: 0;
  text-align: center;
}

.ab-header-page-title:empty {
  display: none;
}

.ab-header-page-title :global(h1) {
  position: relative;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 14px 8px;
  font-size: clamp(1rem, 2.2vw, 1.4rem);
  font-weight: 800;
  color: var(--color-text);
  line-height: 1.2;
  text-wrap: balance;
}

.ab-header-page-title :global(h1)::after {
  content: "";
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 2px;
  height: 3px;
  border-radius: 999px;
  background: var(--color-accent);
  box-shadow: 0 0 0 4px var(--glass-green-bg);
}

.logo {
  font-weight: bold;
  font-size: 1.3rem;
  text-decoration: none;
  color: var(--color-text);
  letter-spacing: 0.3px;
  flex: 0 0 auto;
}

.nav {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: flex-end;
  flex-wrap: wrap;
  flex: 0 1 auto;
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  width: 42px;
  height: 42px;
  padding: 0;
  border-radius: 999px;
  border: 1px solid var(--color-border-subtle);
  background: var(--color-panel-tint);
  color: var(--color-text);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  box-shadow: none;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.theme-toggle:hover {
  border-color: var(--glass-green-border);
  box-shadow: none;
}

.theme-toggle__icons {
  position: relative;
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.theme-toggle__icon {
  position: absolute;
  inset: 0;
  width: 20px;
  height: 20px;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.theme-toggle__icon--moon {
  opacity: 1;
  transform: scale(1);
}

:global(:root[data-theme="dark"]) .theme-toggle__icon--moon {
  opacity: 0;
  transform: scale(0.8);
}

:global(:root[data-theme="dark"]) .theme-toggle__icon--sun {
  opacity: 1;
  transform: scale(1);
}

.nav-auth {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.nav-auth--guest {
  gap: 10px;
}

.nav-auth--user {
  gap: 10px;
}

.nav-login {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0.6rem 1.2rem;
  border-radius: 999px;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  font: inherit;
  white-space: nowrap;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  box-shadow: 0 10px 20px rgba(22, 199, 132, 0.25);
}

.nav-login--icon {
  width: 50px;
  height: 46px;
  padding: 0;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 2px;
}

.nav-login svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.nav-login--icon span {
  font-size: 9px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0;
}

.nav-login:hover {
  box-shadow: 0 14px 24px rgba(22, 199, 132, 0.3);
}

.nav-login:active {
  transform: translateY(1px);
}

.nav-login--ghost {
  background: transparent;
  border: 1px solid var(--color-border-subtle);
  color: var(--color-text);
  font-weight: 600;
  box-shadow: none;
}

.nav-login--ghost:hover {
  color: var(--color-text);
  border-color: var(--color-accent);
}

.nav-login--ghost:active {
  transform: translateY(1px);
}

.nav-user {
  font-weight: 600;
  color: var(--color-text);
  padding: 0.4rem 0.8rem;
  border-radius: 999px;
  background: var(--color-panel-tint);
  border: 1px solid var(--color-panel-tint-strong);
}

.nav-user--plain {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

/* Modal: estilos y animaciones */
.ab-modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 120;
}

.ab-modal:not(.ab-is-hidden) {
  animation: ab-modal-fade 0.18s ease;
}

.ab-modal__backdrop {
  position: absolute;
  inset: 0;
  background: var(--color-modal-backdrop);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.ab-modal__panel {
  position: relative;
  z-index: 1;
  width: min(92vw, 420px);
  padding: 20px;
  border-radius: 16px;
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: 0 18px 40px var(--color-shadow-strong);
  display: grid;
  gap: 12px;
}

.ab-modal:not(.ab-is-hidden) .ab-modal__panel {
  animation: ab-modal-pop 0.2s ease;
}

.ab-modal__panel h2 {
  margin: 0;
  text-align: left;
}

.ab-modal__panel p {
  margin: 0;
  color: var(--color-text-muted);
}

.ab-modal__actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.ab-modal__actions .nav-login:not(.nav-login--ghost) {
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 10px 20px rgba(37, 99, 235, 0.22);
}

.ab-modal__actions .nav-login:not(.nav-login--ghost):hover {
  background: #1d4ed8;
  box-shadow: 0 14px 24px rgba(37, 99, 235, 0.28);
}

.ab-modal__actions .nav-login--ghost,
.ab-modal__actions .nav-login--ghost:hover {
  background: transparent;
  border: 1px solid var(--color-border-subtle);
  color: var(--color-text);
  box-shadow: none;
}

@keyframes ab-modal-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ab-modal-pop {
  from {
    transform: translateY(6px);
    opacity: 0.9;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ab-modal:not(.ab-is-hidden),
  .ab-modal:not(.ab-is-hidden) .ab-modal__panel {
    animation: none;
  }
}

/* Avatar de usuario */
.nav-avatar {
  position: relative;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid var(--color-border-soft);
  background: var(--color-panel-tint);
  display: grid;
  place-items: center;
  overflow: visible;
}

.ab-sales-notification-dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: #22c55e;
  border: 2px solid var(--color-bg);
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
  z-index: 2;
}

.nav-cart {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  width: 42px;
  height: 42px;
  border-radius: 999px;
  border: 1px solid var(--glass-green-border);
  background: var(--glass-green-bg);
  color: var(--color-text);
  font-weight: 700;
  text-decoration: none;
  position: relative;
  flex: 0 0 auto;
}

.nav-cart svg {
  width: 22px;
  height: 22px;
}

.nav-cart span {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--color-accent);
  color: var(--color-on-accent);
  border-radius: 999px;
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  line-height: 1;
  border: 2px solid var(--color-surface);
}

.nav-cart-sync {
  font-size: 11px;
  color: var(--color-text);
  background: var(--color-panel-tint-strong);
  border: 1px solid var(--color-border-subtle);
  border-radius: 999px;
  padding: 4px 8px;
}

.nav-avatar img {
  width: 100%;
  height: 100%;
  border-radius: 999px;
  object-fit: cover;
  display: none;
}

@media (max-width: 430px) {
  .header {
    padding: 0.85rem 0;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 12px;
    text-align: center;
  }

  .brand-row,
  .nav,
  .nav-auth,
  .nav-cart-sync {
    /* width: 100%; */
  }

  .brand-row {
    /* flex-direction: column; */
    gap: 8px;
  }

  .ab-header-page-title :global(h1) {
    margin: 0;
    text-align: center;
    font-size: clamp(1rem, 4.9vw, 1.25rem);
  }

  .nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .nav > * {
    max-width: 100%;
  }

  .logo {
    justify-self: center;
  }

  .nav-auth,
  .nav-auth--guest {
    justify-content: center;
  }

  .nav-auth--user {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    /* width: 100%; */
  }

  .nav-user--plain {
    text-align: center;
    /* width: 100%; */
  }

  .nav-cart-sync {
    text-align: center;
    justify-self: center;
  }
}

@media (max-width: 720px) {
  .nav {
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 8px;
  }
}

@media (max-width: 420px) {
  .logo {
    font-size: 1.1rem;
  }

  .ab-header-page-title :global(h1) {
    font-size: 1rem;
  }

  .nav-auth--guest,
  .nav-auth--user {
    /* width: 100%; */
  }

  .nav-auth--guest {
    display: flex;
    flex-direction: row;
    gap: 8px;
  }

  .nav-avatar,
  .nav-login,
  .nav-login--ghost,
  .nav-cart,
  .theme-toggle {
    justify-self: center;
  }

  .nav-login,
  .nav-login--ghost,
  .nav-cart,
  .theme-toggle {
    justify-content: center;
    text-align: center;
  }

  .nav-cart {
    height: 42px;
  }

  .theme-toggle {
    min-height: 34px;
    width: 42px;
  }
}

@media (max-width: 380px) {
  .nav {
    gap: 7px;
  }

  .nav-login,
  .nav-login--ghost,
  .nav-cart,
  .theme-toggle {
    width: 50px;
    height: 50px;
  }
}
</style>

<script>
  import "../scripts/header-auth.js";
  import "../scripts/theme.js";
</script>
