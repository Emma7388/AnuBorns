---
// Componente: acceso rápido a productos y servicios.
const {
  basePath = "",
  title,
  productLabel = "PRODUCTOS",
  serviceLabel = "SERVICIOS",
  productHref,
  serviceHref,
} = Astro.props;
// Normaliza basePath para generar rutas.
const normalizedBasePath = String(basePath).trim().replace(/^\/+|\/+$/g, "").toLowerCase();
---
<!-- Sección con accesos de segundo nivel -->
<section class="level-two">
  <!-- Título opcional -->
  {title && <h1 class="level-two__title">{title}</h1>}

  <!-- Bloques de navegación -->
  <div class="block-group">
    <a href={productHref ?? `/${normalizedBasePath}/productos`} class="level-block">
      {productLabel}
    </a>

    <a href={serviceHref ?? `/${normalizedBasePath}/servicios`} class="level-block">
      {serviceLabel}
    </a>
  </div>
</section>

<style>
  .level-two {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: 18px;
    width: min(980px, 100%);
    margin: 0 auto;
    padding: 4px var(--app-gutter) 0;
  }

  .level-two__title {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 850;
    text-align: center;
    letter-spacing: 0;
  }

  .block-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 30px);
    width: 100%;
  }

  .level-block {
    width: clamp(210px, 25vw, 270px);
    min-height: 78px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 12px;
    border: 1px solid var(--button-elevated-border);
    background: var(--action-primary);
    color: #ffffff;
    text-decoration: none;
    font-size: clamp(1.8rem, 3.2vw, 2.65rem);
    font-weight: 850;
    line-height: 1;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    text-shadow: var(--button-elevated-text-shadow);
    box-shadow: var(--button-elevated-shadow);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      filter 0.18s ease;
  }

  .level-block:first-child {
    background: var(--action-secondary);
  }

  .level-block:hover {
    filter: brightness(1.04);
    transform: translateY(-2px);
    box-shadow: var(--button-elevated-shadow-hover);
  }

  .level-block:active {
    transform: translateY(2px);
  }

  @media (max-width: 900px) {
    .level-two {
      gap: 14px;
    }

    .block-group {
      width: 100%;
      align-items: center;
      flex-direction: column;
      gap: 14px;
    }

    .level-block {
      width: min(310px, 100%);
      min-height: 64px;
      font-size: clamp(1.55rem, 8vw, 2.2rem);
    }
  }

  @media (max-width: 420px) {
    .level-two__title {
      font-size: 1.2rem;
    }
  }
</style>
