---
// Componente: grilla de categorías con fallback local.
import { categories as localCategories } from "../data/categories";
import TitleBadge from "./TitleBadge.astro";
// Props para construir rutas y título.
const { basePath, type, title, hrefBase, icon = "/icons/buscar.svg" } = Astro.props;

// Config de Supabase para intentar leer categorías remotas.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Helper para fetch con headers requeridos.
const fetchJson = async (url: string | URL) => {
  const response = await fetch(url, {
    headers: {
      apikey: supabaseAnonKey,
      Authorization: `Bearer ${supabaseAnonKey}`,
    },
    cache: "no-store",
  });
  if (!response.ok) return null;
  return response.json();
};

// Default: dataset local; si hay Supabase, intenta actualizar.
let categories = localCategories;
if (supabaseUrl && supabaseAnonKey) {
  try {
    const data = await fetchJson(
      `${supabaseUrl}/rest/v1/categories?select=name,slug,icon&order=name.asc`
    );
    if (Array.isArray(data) && data.length > 0) {
      categories = data;
    }
  } catch {
    categories = localCategories;
  }
}
---

<!-- Sección principal de categorías -->
<section class="category-page">
  <!-- Título configurable por props -->
  <TitleBadge title={title ?? type?.toUpperCase()} icon={icon} tone="primary" />
  <!-- Grilla de tarjetas -->
  <div class="grid">
    {categories.map((cat) => (
      <a
        href={hrefBase ? `/${hrefBase}/${cat.slug}` : `/${basePath}/${type}/${cat.slug}`}
        class="category-card"
      >
        <!-- Icono -->
        <span class="category-card__icon">
          <img src={cat.icon} alt="" loading="lazy" />
        </span>
        <!-- Nombre -->
        <span class="category-card__label">{cat.name}</span>
      </a>
))}
  </div>
</section>

<style>
  .category-page {
    width: min(1000px, 100%);
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 14px;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 6px;
  }

  .category-card {
    aspect-ratio: 1 / 1;
    height: auto;
    width: 100%;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 12px;
    border: var(--card-border);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-decoration: none;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.15;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease;
  }

  .category-card__icon {
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px solid rgba(72, 186, 161, 0.28);
    background: rgba(72, 186, 161, 0.14);
  }

  .category-card__icon img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    filter: drop-shadow(0 6px 10px var(--color-shadow));
  }

  .category-card__label {
    text-align: center;
    overflow-wrap: anywhere;
  }

  .category-card:hover {
    border-color: var(--glass-green-border);
    background: var(--color-panel-tint-strong);
    box-shadow: var(--card-hover-shadow);
    transform: translateY(-2px);
  }

  .category-card:active {
    transform: translateY(1px);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .category-card {
      max-width: none;
      gap: 10px;
      padding: 14px 10px;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
      gap: 10px;
    }

    .category-card__icon {
      width: 48px;
      height: 48px;
    }

    .category-card__icon img {
      width: 34px;
      height: 34px;
    }
  }
</style>
