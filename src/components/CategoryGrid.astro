---
// Componente: grilla de categorías con fallback local.
import { categories as localCategories } from "../data/categories";
// Props para construir rutas y título.
const { basePath, type, title, hrefBase } = Astro.props;

// Config de Supabase para intentar leer categorías remotas.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Helper para fetch con headers requeridos.
const fetchJson = async (url) => {
  const response = await fetch(url, {
    headers: {
      apikey: supabaseAnonKey,
      Authorization: `Bearer ${supabaseAnonKey}`,
    },
    cache: "no-store",
  });
  if (!response.ok) return null;
  return response.json();
};

// Default: dataset local; si hay Supabase, intenta actualizar.
let categories = localCategories;
if (supabaseUrl && supabaseAnonKey) {
  try {
    const data = await fetchJson(
      `${supabaseUrl}/rest/v1/categories?select=name,slug,icon&order=name.asc`
    );
    if (Array.isArray(data) && data.length > 0) {
      categories = data;
    }
  } catch {
    categories = localCategories;
  }
}
---

<!-- Sección principal de categorías -->
<section class="category-page">
  <!-- Título configurable por props -->
  <h1>{title ?? type?.toUpperCase()}</h1>
  <!-- Grilla de tarjetas -->
  <div class="grid">
    {categories.map((cat) => (
      <a
        href={hrefBase ? `/${hrefBase}/${cat.slug}` : `/${basePath}/${type}/${cat.slug}`}
        class="category-card"
      >
        <!-- Icono -->
        <span class="category-card__icon">
          <img src={cat.icon} alt="" loading="lazy" />
        </span>
        <!-- Nombre -->
        <span class="category-card__label">{cat.name}</span>
      </a>
))}
  </div>
</section>

<style>
  .category-page h1 {
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 30px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 6px;
  }

  .category-card {
    aspect-ratio: 1 / 1;
    height: auto;
    width: 100%;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 18px;
    transition: 0.25s ease;
  }

  .category-card__icon {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .category-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 6px 10px var(--color-shadow));
  }

  .category-card__label {
    text-align: center;
  }

  .category-card:hover {
    box-shadow: var(--card-hover-shadow);
  }

  .category-card:active {
    transform: translateY(2px);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .category-card {
      max-width: none;
      font-size: 1rem;
      gap: 8px;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
      gap: 18px;
    }
  }
</style>
