---
// Página pública de proveedor por user_id.
export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { getCurrentInternalPath, withReturnPath } from "../../lib/internalNavigation.js";
import TitleBadge from "../../components/TitleBadge.astro";
import { filterAvailableProducts } from "../../lib/soldProducts.js";
import { getSupabaseAdmin } from "../../lib/supabaseServer.js";

const { userId } = Astro.params;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const safeUserId = encodeURIComponent(userId ?? "");

const fetchJson = async (url) => {
  const response = await fetch(url, {
    headers: {
      apikey: supabaseAnonKey,
      Authorization: `Bearer ${supabaseAnonKey}`,
      "Cache-Control": "no-store",
    },
    cache: "no-store",
  });
  if (!response.ok) return null;
  return response.json();
};

const products = supabaseUrl && supabaseAnonKey && safeUserId
  ? await fetchJson(
      `${supabaseUrl}/rest/v1/products?select=id,title,description,price,currency,image_url,location,delivery_methods,pickup_address,contact,seller_name,user_id,created_at&user_id=eq.${safeUserId}&order=created_at.desc`
    )
  : [];

const rawProducts = Array.isArray(products) ? products : [];
const supabaseAdmin = getSupabaseAdmin();
const profileUserId = String(userId ?? "").trim();
const isProfileUserIdValid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(profileUserId);
const { data: publicProfile } = supabaseAdmin && isProfileUserIdValid
  ? await supabaseAdmin
      .from("profiles")
      .select("phone")
      .eq("user_id", profileUserId)
      .maybeSingle()
  : { data: null };
const safeProducts = supabaseAdmin
  ? await filterAvailableProducts(supabaseAdmin, rawProducts)
  : rawProducts;
const first = rawProducts[0] ?? null;

const sellerName = first?.seller_name || "Proveedor";
const rawContact = String(first?.contact ?? "").trim();
const emailMatch = rawContact.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i);
const publicEmail = emailMatch?.[0] ?? "";
/* El teléfono público pertenece al perfil del proveedor, no a una publicación. */
const publicPhone = String(publicProfile?.phone ?? "").trim();
const phoneDigits = publicPhone.replace(/\D+/g, "");
const publicAddress = String(first?.pickup_address ?? "").trim();
const publicLocation = String(first?.location ?? "").trim();

const formatPrice = (value) => {
  const safe = Number(value ?? 0);
  return safe.toLocaleString("es-AR");
};
const formatDate = (value) => {
  if (!value) return "Sin fecha";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "Sin fecha";
  return date.toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" });
};
const formatDelivery = (value) => {
  if (!Array.isArray(value) || value.length === 0) return "No especificada";
  const labels = value.map((item) => {
    if (item === "retiro") return "Retiro";
    if (item === "envio") return "Envío";
    return item;
  });
  return labels.join(" + ");
};
const serializeDelivery = (value) =>
  Array.isArray(value) ? value.map((item) => String(item ?? "").trim().toLowerCase()).filter(Boolean).join(",") : "";
const getProductHref = (product) => {
  const productId = String(product?.id ?? "").trim();
  return productId ? withReturnPath(`/producto/${encodeURIComponent(productId)}`, getCurrentInternalPath(Astro.url)) : "#";
};
const shortId = (value) => {
  const raw = String(value ?? "").replace(/-/g, "");
  return raw ? raw.slice(0, 6).toUpperCase() : "N/A";
};
---

<MainLayout title={`Proveedor: ${sellerName}`} backHref="/comprar">
  {first ? (
    <section class="ab-dark-panel">
      <p class="ab-eyebrow">Perfil público</p>
      <TitleBadge title={sellerName} icon="/icons/proveedor.svg" tone="primary" />
      <p class="ab-muted-text">Datos públicos del proveedor.</p>

      <div class="ab-provider-profile__meta" aria-label="Datos públicos del proveedor">
        <p class="ab-provider-profile__item">
          <span class="ab-provider-profile__icon" aria-hidden="true">
            <img src="/icons/telefono.svg" alt="" loading="lazy" />
          </span>
          {publicPhone ? (
            <a
              href={`https://wa.me/${phoneDigits}?text=${encodeURIComponent(`Hola ${sellerName}, te contacto por Desoluciones.`)}`}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={`Teléfono: ${publicPhone}`}
              title="Teléfono"
            >
              {publicPhone}
            </a>
          ) : "No publicado"}
        </p>
        <p class="ab-provider-profile__item">
          <span class="ab-provider-profile__icon" aria-hidden="true">
            <img src="/icons/correo-electronico.svg" alt="" loading="lazy" />
          </span>
          {publicEmail ? (
            <a href={`mailto:${publicEmail}`} aria-label={`Email: ${publicEmail}`} title="Email">
              {publicEmail}
            </a>
          ) : "No publicado"}
        </p>
        <p class="ab-provider-profile__item">
          <span class="ab-provider-profile__icon" aria-hidden="true">
            <img src="/icons/casa.svg" alt="" loading="lazy" />
          </span>
          <span aria-label={`Dirección: ${publicAddress || "No publicada"}`} title="Dirección">
            {publicAddress || "No publicada"}
          </span>
        </p>
        <p class="ab-provider-profile__item">
          <span class="ab-provider-profile__icon" aria-hidden="true">
            <img src="/icons/ciudad.svg" alt="" loading="lazy" />
          </span>
          <span aria-label={`Ubicación: ${publicLocation || "No publicada"}`} title="Ubicación">
            {publicLocation || "No publicada"}
          </span>
        </p>
      </div>

      <TitleBadge title="Productos publicados" icon="/icons/destacado.svg" level={2} tone="secondary" class="ab-title-badge--spaced" />
      {safeProducts.length === 0 ? (
        <div class="ab-cart-empty">
          <p>Este proveedor todavía no publicó productos.</p>
        </div>
      ) : (
        <div class="ab-provider-products-grid">
          {safeProducts.map((product) => (
            <article
              class="ab-provider-product-card"
              data-user-id={product.user_id || ""}
              data-title={product.title || ""}
              data-price={product.price ?? 0}
              data-image={product.image_url || "/logo2.svg"}
              data-provider={product.seller_name || sellerName || "Vendedor"}
              data-currency={product.currency || "ARS"}
              data-delivery={serializeDelivery(product.delivery_methods)}
              data-cart-id={product.id || ""}
            >
              <img
                class="ab-provider-product-card__image"
                src={product.image_url || "/logo2.svg"}
                alt={product.title || "Producto"}
                loading="lazy"
              />
              <div class="ab-provider-product-card__meta">
                <div>
                  <p class="ab-provider-product-card__label">Producto</p>
                  <p class="ab-provider-product-card__code">ID {shortId(product.id)}</p>
                </div>
                <p class="ab-provider-product-card__price">
                  ${formatPrice(product.price)} <span>{product.currency || "ARS"}</span>
                </p>
              </div>
              <h2>{product.title || "Sin título"}</h2>
              <p class="ab-provider-product-card__description">{product.description || "Sin descripción"}</p>
              <ul class="ab-provider-product-card__details">
                <li>Fecha: <strong>{formatDate(product.created_at)}</strong></li>
                <li>Ubicación: <strong>{product.location || "Sin especificar"}</strong></li>
                {product.pickup_address ? (
                  <li>Dirección: <strong>{product.pickup_address}</strong></li>
                ) : null}
                <li>Entrega: <strong>{formatDelivery(product.delivery_methods)}</strong></li>
              </ul>
              <div class="ab-provider-product-card__actions ab-provider-product-card__actions--split">
                <a
                  class="ab-featured-products-detail"
                  href={getProductHref(product)}
                  aria-disabled={product.id ? null : "true"}
                >
                  <img src="/icons/detalle.svg" alt="" aria-hidden="true" />
                  <span>Detalle</span>
                </a>
                <button
                  type="button"
                  class="ab-provider-product-card__add"
                  aria-label="Enviar al carrito"
                  title="Enviar al carrito"
                  >
                    <img src="/icons/carrito.svg" alt="" aria-hidden="true" />
                    <span>Enviar al carrito</span>
                  </button>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  ) : (
    <section class="ab-dark-panel">
      <TitleBadge title="Proveedor no encontrado" icon="/icons/proveedor.svg" tone="warning" />
      <p>Este proveedor no tiene datos públicos cargados todavía.</p>
    </section>
  )}
</MainLayout>

<script>
  import "../../scripts/comprar-productos.js";
</script>

<style>
  .ab-provider-profile__meta {
    width: min(620px, 100%);
    margin: 14px auto 22px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .ab-provider-profile__item {
    min-width: 0;
    min-height: 54px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 11px;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--button-radius);
    background: var(--color-panel-tint);
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1.2;
  }

  .ab-provider-profile__item a,
  .ab-provider-profile__item span:last-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ab-provider-profile__item a {
    color: var(--color-text);
    text-decoration: none;
  }

  .ab-provider-profile__item a:hover,
  .ab-provider-profile__item a:focus-visible {
    color: var(--color-link);
    text-decoration: underline;
  }

  .ab-provider-profile__icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: inline-grid;
    place-items: center;
    border-radius: var(--button-radius);
    border: 1px solid var(--button-elevated-border);
    background: var(--action-secondary);
    box-shadow: var(--button-elevated-shadow);
  }

  .ab-provider-profile__icon svg,
  .ab-provider-profile__icon img {
    width: 22px;
    height: 22px;
    display: block;
    object-fit: contain;
    fill: #ffffff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.22));
  }

  .ab-provider-profile__item:nth-child(1) .ab-provider-profile__icon,
  .ab-provider-profile__item:nth-child(3) .ab-provider-profile__icon {
    background: var(--action-success);
  }

  .ab-provider-profile__item:nth-child(4) .ab-provider-profile__icon {
    background: var(--action-primary);
  }

  @media (max-width: 620px) {
    .ab-provider-profile__meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
