---
// Página: registro de usuario.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Crear cuenta">
  <!-- Panel de registro -->
  <section class="ab-dark-panel">
    <TitleBadge title="Creá tu cuenta" icon="/icons/crearcuenta.svg" tone="primary" />

    <!-- Formulario de registro -->
    <form class="ab-form" id="register-form">
      <label for="avatar">Foto de perfil (opcional)</label>
      <div class="ab-profile-avatar ab-register-avatar-preview ab-is-hidden">
        <img id="register-avatar-preview" alt="Vista previa de la foto de perfil" />
      </div>
      <label class="ab-upload-button ab-profile-upload-button" for="avatar">
        <img src="/icons/buscar.svg" alt="" aria-hidden="true" />
        <span>Seleccionar archivo</span>
      </label>
      <input id="avatar" name="avatar" type="file" accept="image/png,image/jpeg,image/webp" class="ab-upload-input" />

      <label for="first-name">Nombre</label>
      <input id="first-name" name="first-name" type="text" placeholder="Ej: María" autocomplete="given-name" minlength="2" maxlength="60" required />

      <label for="last-name">Apellido</label>
      <input id="last-name" name="last-name" type="text" placeholder="Ej: López" autocomplete="family-name" minlength="2" maxlength="60" required />

      <label for="email">Email</label>
      <input id="email" name="email" type="email" placeholder="tu@email.com" autocomplete="email" required />

      <label for="phone">Teléfono <span class="ab-label-hint">sin 0 y sin 15</span></label>
      <input id="phone" name="phone" type="tel" inputmode="numeric" pattern="[0-9]{8,15}" maxlength="15" data-register-digits data-phone-input placeholder="Ej: 1123456789" autocomplete="tel" required />

      <label for="dni">DNI</label>
      <input id="dni" name="dni" type="text" inputmode="numeric" pattern="[0-9]{7,8}" minlength="7" maxlength="8" data-register-digits placeholder="Ej: 12345678" autocomplete="off" required />

      <label for="address">Dirección</label>
      <input id="address" name="address" type="text" placeholder="Ej: Av. Siempre Viva 742" autocomplete="street-address" minlength="4" maxlength="120" required />

      <label for="city">Ciudad</label>
      <input id="city" name="city" type="text" placeholder="Ej: Buenos Aires" autocomplete="address-level2" minlength="2" maxlength="80" required />

      <label for="province">Provincia</label>
      <input id="province" name="province" type="text" placeholder="Ej: Buenos Aires" autocomplete="address-level1" minlength="2" maxlength="80" required />

      <label for="postal-code">Código postal</label>
      <input id="postal-code" name="postal-code" type="text" placeholder="Ej: B1675" autocomplete="postal-code" minlength="4" maxlength="10" required />

      <label for="password">Contraseña</label>
      <p class="ab-form-help" id="register-password-requirements">
        Mínimo 8 caracteres, 1 mayúscula, 1 carácter especial y 1 número.
      </p>
      <span class="ab-field-with-toggle">
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Elegí una contraseña nueva"
          autocomplete="new-password"
          minlength="8"
          pattern="(?=.*[A-ZÁÉÍÓÚÑ])(?=.*[0-9])(?=.*[^A-Za-zÁÉÍÓÚÑáéíóúñ0-9]).{8,}"
          title="Mínimo 8 caracteres, 1 mayúscula, 1 carácter especial y 1 número."
          aria-describedby="register-password-requirements"
          required
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password"
          aria-label="Mostrar contraseña"
          aria-pressed="false"
          title="Mostrar contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>
      <label for="password-confirm">Confirmar contraseña</label>
      <span class="ab-field-with-toggle">
        <input
          id="password-confirm"
          name="password-confirm"
          type="password"
          placeholder="Repetí tu contraseña"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password-confirm"
          aria-label="Mostrar confirmación de contraseña"
          aria-pressed="false"
          title="Mostrar confirmación de contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>

      <button type="submit" class="ab-cta-button" id="register-submit">
        <img src="/icons/crearcuenta.svg" alt="" aria-hidden="true" />
        <span>Crear cuenta</span>
      </button>
      <p id="register-feedback" class="ab-muted-text" aria-live="polite"></p>
    </form>
  </section>
</MainLayout>

<!-- Script de registro -->
<script>
  import "../scripts/register.js";
  import "../scripts/password-visibility.js";
</script>
