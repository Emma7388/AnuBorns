---
// Página: registro de usuario.
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Crear cuenta">
  <!-- Panel de registro -->
  <section class="ab-dark-panel">
    <p class="ab-eyebrow">Registro</p>
    <h1>Creá tu cuenta</h1>
    <p class="ab-muted-text">
      Tu correo se usa para identificar tu cuenta. La contraseña la creás acá.
    </p>

    <!-- Formulario de registro -->
    <form class="ab-form" id="register-form">
      <label for="avatar">Avatar (opcional)</label>
      <label class="ab-upload-button" for="avatar">Subir imagen</label>
      <input id="avatar" name="avatar" type="file" accept="image/*" class="ab-upload-input" />
      <span class="ab-muted-text ab-upload-help">Podés sumar una foto de perfil ahora o cargarla después.</span>

      <label for="first-name">Nombre</label>
      <input id="first-name" name="first-name" type="text" placeholder="Ej: María" autocomplete="given-name" />

      <label for="last-name">Apellido</label>
      <input id="last-name" name="last-name" type="text" placeholder="Ej: López" autocomplete="family-name" />

      <label for="email">Email</label>
      <input id="email" name="email" type="email" placeholder="tu@email.com" autocomplete="email" required />
      <p class="ab-form-help">Usamos tu email para tu cuenta y para avisos importantes.</p>

      <label for="phone">Teléfono <span class="ab-label-hint">sin 0 y sin 15</span></label>
      <input id="phone" name="phone" type="tel" inputmode="numeric" pattern="[0-9]*" data-phone-input placeholder="Ej: 1123456789" autocomplete="tel" />

      <label for="dni">DNI</label>
      <input id="dni" name="dni" type="text" placeholder="Ej: 12345678" />

      <label for="address">Dirección</label>
      <input id="address" name="address" type="text" placeholder="Ej: Av. Siempre Viva 742" autocomplete="street-address" />

      <label for="city">Ciudad</label>
      <input id="city" name="city" type="text" placeholder="Ej: Buenos Aires" autocomplete="address-level2" />

      <label for="province">Provincia</label>
      <input id="province" name="province" type="text" placeholder="Ej: Buenos Aires" autocomplete="address-level1" />

      <label for="postal-code">Código postal</label>
      <input id="postal-code" name="postal-code" type="text" placeholder="Ej: B1675" autocomplete="postal-code" />

      <label for="password">Contraseña para Desoluciones</label>
      <input
        id="password"
        name="password"
        type="password"
        placeholder="Elegí una contraseña nueva"
        autocomplete="new-password"
        minlength="6"
        required
      />
      <p class="ab-form-help">No uses la contraseña de tu email.</p>

      <label for="password-confirm">Confirmar contraseña</label>
      <input
        id="password-confirm"
        name="password-confirm"
        type="password"
        placeholder="Repetí tu contraseña"
        autocomplete="new-password"
        minlength="6"
        required
      />

      <button type="submit" class="ab-cta-button">Crear cuenta</button>
      <p id="register-feedback" class="ab-muted-text" aria-live="polite"></p>
    </form>
  </section>
</MainLayout>

<!-- Script de registro -->
<script>
  import "../scripts/register.js";
</script>
