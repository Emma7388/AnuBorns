---
// Página: carrito con listado y resumen.
import MainLayout from "../layouts/MainLayout.astro";
import ConfirmationModal from "../components/ConfirmationModal.astro";
---

<MainLayout title="Carrito" backHref="/comprar">
  <!-- Panel principal del carrito -->
  <section class="ab-dark-panel ab-cart-panel">
    <!-- Estado vacío -->
    <div id="cart-empty" class="ab-cart-empty">
      <img class="ab-cart-empty-icon" src="/icons/carrito.svg" alt="" aria-hidden="true" />
      <h2>Todavía no agregaste productos</h2>
      <p>Explorá las categorías y elegí lo que necesitás.</p>
      <a href="/comprar" class="ab-cta-button">Ver productos</a>
    </div>

    <!-- Items renderizados por JS -->
    <div id="cart-items" class="ab-cart-items" aria-live="polite"></div>

    <!-- Resumen y acciones -->
    <div class="ab-cart-summary ab-is-hidden">
      <p class="ab-cart-summary__total">
        TOTAL: <strong id="cart-total">$0</strong>
      </p>
      <div class="ab-actions">
        <button id="cart-checkout" class="ab-cta-button ab-cart-action ab-cart-action--checkout" type="button">
          <img src="/icons/comprar.svg" alt="" aria-hidden="true" />
          <span>Finalizar compra</span>
        </button>
        <button id="cart-clear" class="ab-cart-action ab-cart-action--clear" type="button">
          <img src="/icons/borrar.svg" alt="" aria-hidden="true" />
          <span>Vaciar carrito</span>
        </button>
      </div>
      <p id="cart-feedback" class="ab-muted-text" aria-live="polite"></p>
    </div>
  </section>

  <ConfirmationModal
    id="cart-remove-modal"
    titleId="cart-remove-title"
    title="Quitar producto"
    closeAttribute="data-cart-modal-close"
  >
      <p>¿Seguro que querés quitar este producto del carrito?</p>
      <Fragment slot="actions">
        <button type="button" class="ab-orders-delete-btn ab-orders-delete-btn--ghost ab-cart-action ab-cart-action--clear" data-cart-modal-cancel>
          <img src="/icons/atras.svg" alt="" aria-hidden="true" />
          <span>Cancelar</span>
        </button>
        <button type="button" class="ab-orders-delete-btn ab-cart-action ab-cart-action--checkout" data-cart-modal-confirm>
          <img src="/icons/borrar.svg" alt="" aria-hidden="true" />
          <span>Sí, quitar</span>
        </button>
      </Fragment>
  </ConfirmationModal>
</MainLayout>

<style>
  #cart-empty {
    justify-items: center;
    gap: 12px;
    padding: 28px 12px;
    text-align: center;
  }

  .ab-cart-empty-icon {
    width: 56px;
    height: 56px;
  }

  #cart-empty h2 {
    margin: 0;
    font-size: clamp(20px, 4vw, 26px);
    line-height: 1.25;
  }

  #cart-empty p {
    margin: 0;
    color: var(--color-text-muted);
  }

  #cart-empty .ab-cta-button {
    margin-top: 8px;
  }
</style>

<!-- Script de interacción del carrito -->
<script>
  import "../scripts/cart.js";
</script>
