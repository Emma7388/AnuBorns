---
// Página: perfil del usuario.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Mis datos">
  <!-- Panel de perfil -->
  <section class="ab-dark-panel ab-profile-data">
    <p class="ab-eyebrow">Perfil</p>
    <TitleBadge title="Mis datos" icon="/icons/proveedor.svg" tone="primary" />
    <!-- Estado de carga -->
    <p class="ab-muted-text" id="profile-status">
      Cargando información del usuario...
    </p>

    <!-- Form de avatar -->
    <form class="ab-form" id="avatar-form">
      <!-- Avatar -->
      <div class="ab-profile-avatar">
        <img id="profile-avatar" alt="Avatar" />
      </div>
      <span class="ab-form-label">Actualizar imagen de perfil</span>
      <label class="ab-upload-button ab-profile-upload-button" for="avatar-upload">
        <img src="/icons/buscar.svg" alt="" aria-hidden="true" />
        <span>Seleccionar archivo</span>
      </label>
      <input id="avatar-upload" class="ab-upload-input" name="avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" />
      <p class="ab-muted-text" id="avatar-feedback" aria-live="polite"></p>
    </form>

    <!-- CTA de edición -->
    <div class="ab-actions">
      <button type="button" class="ab-cta-button ab-profile-action ab-profile-action--edit" id="profile-edit-toggle">
        <img src="/icons/detalle.svg" alt="" aria-hidden="true" />
        <span>Editar perfil</span>
      </button>
    </div>

    <!-- Form de datos del perfil -->
    <form class="ab-form" id="profile-form" novalidate>
      <label for="profile-email">Email</label>
      <input id="profile-email" name="profile-email" type="email" autocomplete="email" readonly />

      <label for="profile-first-name">Nombre</label>
      <input id="profile-first-name" name="profile-first-name" type="text" autocomplete="given-name" minlength="2" maxlength="60" required />

      <label for="profile-last-name">Apellido</label>
      <input id="profile-last-name" name="profile-last-name" type="text" autocomplete="family-name" minlength="2" maxlength="60" required />

      <label for="profile-phone">Teléfono <span class="ab-label-hint">sin 0 y sin 15</span></label>
      <input id="profile-phone" name="profile-phone" type="tel" inputmode="numeric" pattern="[0-9]{8,15}" maxlength="15" autocomplete="tel" data-profile-digits data-phone-input required />

      <label for="profile-dni">DNI</label>
      <input id="profile-dni" name="profile-dni" type="text" inputmode="numeric" pattern="[0-9]{7,8}" minlength="7" maxlength="8" autocomplete="off" data-profile-digits required />

      <label for="profile-address">Dirección</label>
      <input id="profile-address" name="profile-address" type="text" autocomplete="street-address" minlength="4" maxlength="120" required />

      <label for="profile-city">Ciudad</label>
      <input id="profile-city" name="profile-city" type="text" autocomplete="address-level2" minlength="2" maxlength="80" required />

      <label for="profile-province">Provincia</label>
      <input id="profile-province" name="profile-province" type="text" autocomplete="address-level1" minlength="2" maxlength="80" required />

      <label for="profile-postal-code">Código postal</label>
      <input id="profile-postal-code" name="profile-postal-code" type="text" autocomplete="postal-code" minlength="4" maxlength="10" required />

      <button type="submit" class="ab-cta-button ab-profile-action ab-profile-action--save">
        <img src="/icons/adelante.svg" alt="" aria-hidden="true" />
        <span>Guardar cambios</span>
      </button>
      <p class="ab-muted-text" id="profile-feedback" aria-live="polite"></p>
    </form>

    <!-- Resumen en tarjeta -->
    <div class="ab-profile-data__card" id="profile-card"></div>

    <!-- Accesos a secciones relacionadas -->
    <div class="ab-actions">
      <a class="ab-cta-button ab-purchases-link ab-profile-action ab-profile-action--buy" href="/mis-compras">
        <img src="/icons/carrito.svg" alt="" aria-hidden="true" />
        <span>Ver mis compras</span>
        <span id="my-purchases-notification-dot" class="ab-purchase-notification-dot ab-is-hidden" aria-hidden="true"></span>
      </a>
      <a class="ab-cta-button ab-sales-link ab-profile-action ab-profile-action--sell" href="/mis-ventas">
        <img src="/icons/proveedor.svg" alt="" aria-hidden="true" />
        <span>Ver mis ventas</span>
        <span id="my-sales-notification-dot" class="ab-sales-notification-dot ab-is-hidden" aria-hidden="true"></span>
      </a>
    </div>
  </section>
</MainLayout>

<script>
  import "../scripts/profile.js";
</script>
