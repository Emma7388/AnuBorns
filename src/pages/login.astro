---
// Página: login de usuario.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Iniciar sesión">
  <section class="ab-dark-panel">
    <TitleBadge title="Ingresá a tu cuenta" icon="/icons/iniciarsesion.svg" tone="primary" />

    <form class="ab-form" id="login-form" method="post">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        placeholder="tu@email.com"
        autocomplete="email"
        required
      />

      <label for="password">Contraseña</label>
      <p class="ab-login-reset-help" id="password-requirements">
        Mínimo 8 caracteres, 1 mayúscula, 1 carácter especial y 1 número.
      </p>
      <span class="ab-field-with-toggle">
        <input
          id="password"
          name="password"
          type="password"
          placeholder="••••••••"
          autocomplete="current-password"
          aria-describedby="password-requirements"
          required
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password"
          aria-label="Mostrar contraseña"
          aria-pressed="false"
          title="Mostrar contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>
      <button class="ab-login-forgot" type="button" id="forgot-password">
        ¿Olvidaste tu contraseña?
      </button>
      <div class="ab-actions">
        <button type="submit" class="ab-cta-button" id="login-submit">
          <img src="/icons/iniciarsesion.svg" alt="" aria-hidden="true" />
          <span>Ingresar</span>
        </button>
        <a class="ab-cta-button ab-cta-button--ghost" href="/registro">
          <img src="/icons/crearcuenta.svg" alt="" aria-hidden="true" />
          <span>Crear cuenta</span>
        </a>
      </div>
      <p id="login-feedback" class="ab-muted-text" aria-live="polite"></p>
    </form>
  </section>
</MainLayout>

<style>
  .ab-login-forgot {
    width: fit-content;
    margin-top: -4px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-link);
    box-shadow: none;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 800;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ab-login-forgot:hover,
  .ab-login-forgot:focus-visible {
    color: var(--color-accent-strong);
    box-shadow: none;
  }

  .ab-login-forgot:active {
    transform: none;
  }

  .ab-login-reset-help {
    margin: -8px 0 -2px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }
</style>

<!-- Script de login -->
<script>
  import "../scripts/login.js";
  import "../scripts/password-visibility.js";
</script>
