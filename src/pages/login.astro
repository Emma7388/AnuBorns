---
// Página: login de usuario.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Iniciar sesión">
  <!-- Panel de acceso -->
  <section class="ab-dark-panel">
    <p class="ab-eyebrow">Acceso</p>
    <TitleBadge title="Ingresá a tu cuenta" icon="/icons/iniciarsesion.svg" tone="primary" />
    <p class="ab-muted-text">
      Ingresá con el email de tu cuenta y la contraseña que creaste para Desoluciones.
    </p>

    <!-- Formulario de login -->
    <form class="ab-form" id="login-form" method="post">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        placeholder="tu@email.com"
        autocomplete="email"
        required
      />

      <label for="password">Contraseña</label>
      <span class="ab-field-with-toggle">
        <input
          id="password"
          name="password"
          type="password"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password"
          aria-label="Mostrar contraseña"
          aria-pressed="false"
          title="Mostrar contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>
      <div class="ab-actions">
        <button type="submit" class="ab-cta-button" id="login-submit">
          <img src="/icons/iniciarsesion.svg" alt="" aria-hidden="true" />
          <span>Ingresar</span>
        </button>
        <a class="ab-cta-button ab-cta-button--ghost" href="/registro">
          <img src="/icons/crearcuenta.svg" alt="" aria-hidden="true" />
          <span>Crear cuenta</span>
        </a>
      </div>
      <p id="login-feedback" class="ab-muted-text" aria-live="polite"></p>
    </form>
  </section>
</MainLayout>

<!-- Script de login -->
<script>
  import "../scripts/login.js";
  import "../scripts/password-visibility.js";
</script>
