---
// Página de inicio con accesos principales.
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Desoluciones" headerTitle="">
  <!-- Hero principal -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-brand">
        <div class="hero-logo-wrap">
          <img class="hero-logo" src="/Logo_Final.webp" alt="Desoluciones.com" loading="eager" />
        </div>
        <h1>Comprá, vendé y ofertá en un solo lugar</h1>
      </div>

      <!-- CTAs principales -->
      <div class="hero-buttons">
        <a href="/comprar" class="ab-cta-button hero-button hero-button--buy" data-astro-reload>
          Comprá
        </a>

        <a href="/vender" class="ab-cta-button hero-button hero-button--sell" data-astro-reload>
          Vendé
        </a>

        <a href="/oferta" class="ab-cta-button hero-button hero-button--offer" data-astro-reload>
          Ofertá
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(main[data-ab-pathname="/"]) {
    min-height: calc(100dvh - var(--header-height) - var(--footer-height));
    display: grid;
    place-items: center;
    padding: clamp(10px, 2dvh, 18px) var(--app-gutter);
  }

  .hero {
    width: min(1180px, 100%);
    min-height: min(680px, calc(100dvh - var(--header-height) - var(--footer-height) - clamp(20px, 4dvh, 36px)));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 4px;
  }

  .hero-content {
    width: min(900px, 100%);
    display: grid;
    justify-items: center;
    gap: clamp(18px, 3.5dvh, 36px);
  }

  .hero-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 3vw, 34px);
    min-width: 0;
    min-height: clamp(210px, 36dvh, 360px);
  }

  .hero-logo-wrap {
    width: min(34dvh, 340px);
    aspect-ratio: 1;
    display: inline-grid;
    place-items: center;
    box-sizing: border-box;
    padding: 6px;
    border-radius: 50%;
    grid-template-columns: 1fr;
    flex: 0 0 min(34dvh, 340px);
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0) 50%, transparent 100%);
  }

  .hero-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .hero h1 {
    margin: 0;
    color: #4f958a;
    font-size: clamp(2.45rem, 4.85vw, 4.15rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0;
    text-align: left;
    flex: 0.8 1 0;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.78);
  }

  .hero-buttons {
    display: flex;
    gap: clamp(18px, 3vw, 30px);
    justify-content: center;
    flex-wrap: nowrap;
    width: 100%;
  }

  .hero-buttons .ab-cta-button {
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    max-width: 270px;
    min-height: 78px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 12px;
    color: #ffffff;
    border: 1px solid var(--button-elevated-border);
    font-size: clamp(1.8rem, 3.2vw, 2.65rem);
    font-weight: 850;
    line-height: 1;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    text-shadow: var(--button-elevated-text-shadow);
    box-shadow: var(--button-elevated-shadow);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      filter 0.18s ease;
  }

  .hero-button--buy {
    background: var(--action-secondary);
  }

  .hero-button--sell {
    background: var(--action-primary);
  }

  .hero-button--offer {
    background: var(--action-success);
  }

  .hero-buttons .ab-cta-button:hover {
    filter: brightness(1.04);
    transform: translateY(-2px);
    box-shadow: var(--button-elevated-shadow-hover);
  }

  @media (max-width: 900px) {
    .hero h1 {
      font-size: clamp(1.75rem, 6.6vw, 2.25rem);
      margin-bottom: 0;
    }

    .hero-buttons {
      gap: 12px;
    }

    .hero-buttons .ab-cta-button {
      padding: 12px 18px;
    }
  }

  @media (max-width: 768px) {
    :global(main[data-ab-pathname="/"]) {
      padding-block: clamp(8px, 1.5dvh, 14px);
    }

    .hero {
      min-height: calc(100dvh - var(--header-height) - var(--footer-height) - clamp(16px, 3dvh, 28px));
    }

    .hero-content {
      gap: clamp(14px, 2.8dvh, 24px);
    }

    .hero-brand {
      gap: clamp(10px, 3vw, 16px);
      min-height: clamp(150px, 30dvh, 240px);
    }

    .hero-logo-wrap {
      width: clamp(118px, 34vw, 180px);
      flex-basis: clamp(118px, 34vw, 180px);
    }

    .hero h1 {
      font-size: clamp(1.8rem, 8vw, 2.55rem);
    }

    .hero-buttons {
      gap: 14px;
    }

    .hero-buttons .ab-cta-button {
      min-height: 64px;
      font-size: clamp(1.15rem, 5.4vw, 2rem);
    }
  }

  @media (max-width: 420px) {
    .hero-brand {
      min-height: clamp(130px, 26dvh, 190px);
    }

    .hero-logo-wrap {
      width: clamp(104px, 32vw, 138px);
      flex-basis: clamp(104px, 32vw, 138px);
    }

    .hero-buttons {
      gap: 8px;
    }

    .hero-buttons .ab-cta-button {
      min-height: 54px;
      padding: 10px 8px;
      font-size: clamp(0.95rem, 5.6vw, 1.35rem);
    }

    .hero h1 {
      font-size: clamp(1.45rem, 7.8vw, 1.8rem);
      margin-bottom: 0;
    }
  }
</style>
