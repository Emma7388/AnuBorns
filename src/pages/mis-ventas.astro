---
// Página: ventas del usuario.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Mis ventas" backHref="/mis-datos">
  <!-- Panel principal -->
  <section class="ab-dark-panel ab-orders-panel">
    <p class="ab-eyebrow">Panel de vendedor</p>
    <TitleBadge title="Mis ventas" icon="/icons/proveedor.svg" tone="primary" />
    <p class="ab-muted-text">
      Revisá tus productos vendidos, prepará entregas y administrá tus publicaciones activas.
    </p>

    <!-- Productos vendidos -->
    <TitleBadge title="Productos vendidos" icon="/icons/carrito.svg" level={2} tone="success" />
    <label class="ab-sales-dispatch-filter">
      <input id="my-sold-products-dispatch-filter" type="checkbox" />
      <span>Mostrar solo productos para despachar</span>
    </label>
    <form id="my-sold-products-date-filter" class="ab-sales-date-filter">
      <label><span>Desde</span><input id="my-sold-products-from" type="date" /></label>
      <label><span>Hasta</span><input id="my-sold-products-to" type="date" /></label>
      <button type="submit" class="ab-sales-date-filter__apply">Buscar</button>
      <button type="button" id="my-sold-products-date-clear" class="ab-sales-date-filter__clear">Limpiar</button>
    </form>
    <p id="my-sold-products-status" class="ab-muted-text"></p>
    <div id="my-sold-products-list" class="ab-orders-list"></div>
    <nav id="my-sold-products-pagination" class="ab-sales-pagination" aria-label="Paginación de productos vendidos"></nav>
    <div id="my-sold-products-empty" class="ab-cart-empty ab-is-hidden">
      <p>Todavía no tenés productos vendidos.</p>
    </div>

    <!-- Productos publicados -->
    <TitleBadge title="Productos publicados" icon="/icons/destacado.svg" level={2} tone="secondary" class="ab-title-badge--spaced" />
    <div id="my-products-grid" class="ab-provider-products-grid"></div>
    <div id="my-products-empty" class="ab-cart-empty ab-is-hidden">
      <p>Todavía no publicaste productos.</p>
    </div>

  </section>

  <!-- Modal de confirmación para borrar producto publicado -->
  <div
    id="sales-delete-modal"
    class="ab-orders-modal ab-is-hidden"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="sales-delete-title"
  >
    <div class="ab-orders-modal__backdrop" data-sales-modal-close></div>
    <div class="ab-orders-modal__panel" role="document">
      <h2 id="sales-delete-title">Borrar producto</h2>
      <p>¿Seguro que querés borrar este producto publicado?</p>
      <div class="ab-orders-modal__actions">
        <button type="button" class="ab-orders-delete-btn ab-orders-delete-btn--ghost" data-sales-modal-cancel>
          Cancelar
        </button>
        <button type="button" class="ab-orders-delete-btn" data-sales-modal-confirm>
          Sí, borrar
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import "../scripts/mis-ventas.js";
</script>
