---
// Página: introducción al flujo de servicios.
import MainLayout from "../../layouts/MainLayout.astro";
import TitleBadge from "../../components/TitleBadge.astro";
---

<MainLayout title="Servicios">
  <!-- Panel informativo -->
  <section class="ab-dark-panel">
    <p class="ab-eyebrow">Flujo de servicios</p>
    <TitleBadge title="Publicá un trabajo y recibí ofertas" icon="/icons/social.svg" tone="primary" />
    <p class="ab-muted-text">
      Contá qué necesitás, compartí los datos clave y coordiná con profesionales
      de la categoría indicada.
    </p>

    <!-- Pasos del flujo -->
    <div class="ab-steps">
      <ol>
        <li>Publicás tu trabajo con detalles básicos.</li>
        <li>Profesionales de la categoría lo ven.</li>
        <li>Recibís ofertas y elegís una.</li>
        <li>Se realiza el trabajo y dejan valoraciones.</li>
      </ol>
    </div>

    <!-- CTA principal -->
    <div class="ab-actions">
      <a class="ab-cta-button" href="/trabajos/publicar?from=%2Fcomprar%2Fservicios">Publicar trabajo</a>
    </div>
  </section>
</MainLayout>
