---
// Página: selector de compras.
import MainLayout from "../layouts/MainLayout.astro";
import { categories } from "../data/categories.js";
import ActionSwitch from "../components/ActionSwitch.astro";
import FeaturedProductsSection from "../components/FeaturedProductsSection.astro";
---

<MainLayout title="Comprá">
  <div class="ab-main-choice-page">
    <ActionSwitch mode="buy" categories={categories} />
    <FeaturedProductsSection />
  </div>
</MainLayout>
