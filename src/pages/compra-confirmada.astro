---
// Página: confirmación de pago.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Estado de compra">
  <!-- Panel principal -->
  <section class="ab-dark-panel ab-confirmation-panel">
    <div class="ab-confirmation-card">
      <!-- Animación check -->
      <div class="ab-checkmark">
        <svg viewBox="0 0 52 52" aria-hidden="true">
          <circle class="ab-checkmark__circle" cx="26" cy="26" r="24" fill="none" />
          <path class="ab-checkmark__check" fill="none" d="M14 27l7 7 16-16" />
        </svg>
      </div>
      <!-- Textos que se actualizan por JS -->
      <TitleBadge title="Estado del pago" icon="/icons/compra.svg" textId="confirmation-title" tone="primary" />
      <p class="ab-muted-text" id="confirmation-message">
        Estamos validando el estado de la compra.
      </p>
      <p class="ab-muted-text" id="confirmation-order"></p>
      <div class="ab-confirmation-actions">
        <button
          id="confirmation-invoice"
          class="ab-cta-button ab-cta-button--ghost ab-is-hidden"
          type="button"
        >
          Ver factura
        </button>
      </div>
    </div>
  </section>
</MainLayout>

<!-- Script de estado de pago -->
<script>
  import "../scripts/confirmation.js";
</script>
