---
// Página: confirmación de publicación.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Publicación confirmada" backHref="/comprar/servicios">
  <!-- Panel principal -->
  <section class="ab-dark-panel ab-confirmation-panel">
    <div class="ab-confirmation-card">
      <!-- Ícono de confirmación -->
      <div class="ab-checkmark">
        <svg viewBox="0 0 52 52" aria-hidden="true">
          <circle class="ab-checkmark__circle" cx="26" cy="26" r="24" fill="none" />
          <path class="ab-checkmark__check" fill="none" d="M14 27l7 7 16-16" />
        </svg>
      </div>
      <!-- Texto de confirmación -->
      <TitleBadge title="Publicación enviada" icon="/icons/adelante.svg" tone="success" />
      <p class="ab-muted-text">
        Tu trabajo se publicó correctamente. Te llevamos al inicio en unos segundos.
      </p>
    </div>
  </section>
</MainLayout>

<script>
  // El flujo de publicar trabajo pertenece a la sección de servicios.
  window.setTimeout(() => {
    window.location.href = "/comprar/servicios";
  }, 4400);
</script>
