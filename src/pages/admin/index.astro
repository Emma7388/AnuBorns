---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/admin.css";
---

<MainLayout title="Panel operativo" headerTitle="Panel operativo" backHref="/mis-datos">
  <section class="ab-dark-panel ab-admin-dashboard">
    <div class="ab-admin-dashboard__head">
      <div>
        <p class="ab-admin-dashboard__eyebrow">Estado interno</p>
        <h2>Operación AnuBorns</h2>
      </div>
      <div class="ab-admin-dashboard__actions">
        <a class="ab-secondary-button" href="/admin/administracion">
          <span>Administración</span>
        </a>
        <a class="ab-secondary-button" href="/admin/usuarios">
          <span>Usuarios</span>
        </a>
      </div>
    </div>

    <div class="ab-admin-summary" id="admin-health-summary">
      <div class="ab-admin-summary__item">
        <strong id="admin-health-ok">0</strong>
        <span>Chequeos OK</span>
      </div>
      <div class="ab-admin-summary__item">
        <strong id="admin-health-warning">0</strong>
        <span>Chequeos a revisar</span>
      </div>
      <div class="ab-admin-summary__item">
        <strong id="admin-health-error">0</strong>
        <span>Chequeos con error</span>
      </div>
    </div>

    <p class="ab-muted-text" id="admin-health-status" aria-live="polite">Cargando estado operativo...</p>

    <section class="ab-admin-metrics" id="admin-supabase-metrics" aria-labelledby="admin-supabase-metrics-title">
      <div class="ab-admin-metrics__head">
        <div>
          <p class="ab-admin-dashboard__eyebrow">Supabase</p>
          <h3 id="admin-supabase-metrics-title">Mediciones del servidor</h3>
        </div>
        <span id="admin-supabase-metrics-meta">Sin datos</span>
      </div>
      <div class="ab-admin-metrics__grid" id="admin-supabase-metrics-list"></div>
    </section>

    <div class="ab-admin-health-workspace">
      <div class="ab-admin-health-tabs" id="admin-health-tabs" role="tablist" aria-label="Procesos operativos"></div>
      <div class="ab-admin-health-grid" id="admin-health-list"></div>
    </div>
    <div class="ab-admin-health-notes" id="admin-health-notes"></div>
  </section>
</MainLayout>

<script>
  import "../../scripts/admin-dashboard.js";
</script>
