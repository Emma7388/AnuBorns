---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/admin.css";
---

<MainLayout title="Administración" headerTitle="Administración" backHref="/admin/">
  <section class="ab-dark-panel ab-admin-finance">
    <div class="ab-admin-dashboard__head">
      <div>
        <p class="ab-admin-dashboard__eyebrow">Administración</p>
        <h2>Fee AnuBorns</h2>
      </div>
      <a class="ab-secondary-button" href="/admin/usuarios">
        <span>Usuarios</span>
      </a>
    </div>

    <p class="ab-muted-text" id="admin-finance-status" aria-live="polite">Cargando administración...</p>

    <div class="ab-admin-finance__summary" aria-label="Resumen de fee">
      <div class="ab-admin-summary__item ab-admin-summary__item--approved">
        <strong id="admin-fee-approved">$0</strong>
        <span>Fee aprobado</span>
      </div>
      <div class="ab-admin-summary__item ab-admin-summary__item--registered">
        <strong id="admin-fee-registered">$0</strong>
        <span>Fee registrado</span>
      </div>
      <div class="ab-admin-summary__item ab-admin-summary__item--orders">
        <strong id="admin-fee-orders">0</strong>
        <span>Ordenes con fee</span>
      </div>
    </div>

    <div class="ab-admin-finance__grid">
      <article class="ab-admin-finance__panel ab-admin-finance__panel--chart">
        <h3>Distribución del fee</h3>
        <div id="admin-finance-chart" class="ab-admin-finance-chart" aria-label="Distribución del fee"></div>
      </article>

      <article class="ab-admin-finance__panel">
        <h3>Resumen</h3>
        <div id="admin-finance-detail" class="ab-admin-finance__detail"></div>
      </article>

      <article class="ab-admin-finance__panel ab-admin-finance__panel--orders">
        <h3>Últimas órdenes con fee</h3>
        <div id="admin-finance-orders" class="ab-admin-finance__orders"></div>
      </article>
    </div>
  </section>
</MainLayout>

<script>
  import "../../scripts/admin-administracion.js";
</script>
