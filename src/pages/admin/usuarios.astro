---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/admin.css";
---

<MainLayout title="Usuarios" headerTitle="Usuarios" backHref="/admin/">
  <section class="ab-dark-panel ab-admin-users">
    <div class="ab-admin-dashboard__head">
      <div>
        <p class="ab-admin-dashboard__eyebrow">Estado interno</p>
        <h2>Gestión de usuarios</h2>
      </div>
      <div class="ab-admin-dashboard__actions">
        <a class="ab-secondary-button" href="/admin/">
          <span>Operación</span>
        </a>
        <a class="ab-secondary-button" href="/admin/administracion">
          <span>Administración</span>
        </a>
      </div>
    </div>

    <div class="ab-admin-users__toolbar">
      <label class="ab-admin-users__search">
        <span>Buscar usuario</span>
        <input
          id="admin-user-search"
          type="search"
          autocomplete="off"
          placeholder="Email, nombre, DNI o teléfono"
        />
      </label>
      <div class="ab-admin-users__actions">
        <button type="button" class="ab-cta-button" id="admin-user-search-button">
          <img src="/icons/buscar.svg" alt="" aria-hidden="true" />
          <span>Buscar</span>
        </button>
        <button type="button" class="ab-secondary-button" id="admin-user-clear-button">
          <span>Limpiar</span>
        </button>
      </div>
    </div>

    <p class="ab-muted-text" id="admin-users-status" aria-live="polite">Cargando usuarios...</p>

    <div class="ab-admin-users__layout">
      <div class="ab-admin-users__side">
        <section class="ab-admin-users__mp-summary" aria-labelledby="admin-users-mp-summary-title">
          <div class="ab-admin-users__mp-chart" id="admin-users-mp-chart" aria-hidden="true"></div>
          <div class="ab-admin-users__mp-copy">
            <p class="ab-admin-dashboard__eyebrow">Mercado Pago</p>
            <h3 id="admin-users-mp-summary-title">Conexión vendedores</h3>
            <div class="ab-admin-users__mp-counts">
              <span><strong id="admin-users-mp-connected">0</strong> conectados</span>
              <span><strong id="admin-users-mp-disconnected">0</strong> sin MP</span>
            </div>
            <small id="admin-users-mp-total">0 usuarios</small>
          </div>
        </section>
        <div class="ab-admin-users__list" id="admin-users-list"></div>
      </div>
      <aside class="ab-admin-users__detail" id="admin-user-detail" aria-live="polite">
        <p class="ab-muted-text">Seleccioná un usuario para ver sus datos.</p>
      </aside>
    </div>

  </section>
</MainLayout>

<script>
  import "../../scripts/admin-users.js";
</script>
