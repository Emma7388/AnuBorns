---
export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import TitleBadge from "../../components/TitleBadge.astro";
import { getSoldProductIds } from "../../lib/soldProducts.js";
import { getSupabaseAdmin } from "../../lib/supabaseServer.js";
import { getCurrentInternalPath, withReturnPath } from "../../lib/internalNavigation.js";

const { id } = Astro.params;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const safeId = encodeURIComponent(String(id ?? "").trim());

const fetchJson = async (url) => {
  const response = await fetch(url, {
    headers: {
      apikey: supabaseAnonKey,
      Authorization: `Bearer ${supabaseAnonKey}`,
      "Cache-Control": "no-store",
    },
    cache: "no-store",
  });
  if (!response.ok) return null;
  return response.json();
};

const product = supabaseUrl && supabaseAnonKey && safeId
  ? await fetchJson(
      `${supabaseUrl}/rest/v1/products?select=id,user_id,title,description,price,currency,image_url,location,delivery_methods,pickup_address,seller_name,created_at&id=eq.${safeId}&limit=1`
    )
  : null;

const rawCurrent = Array.isArray(product) ? product[0] : null;
const supabaseAdmin = getSupabaseAdmin();
const soldProductIds = supabaseAdmin && rawCurrent?.id
  ? await getSoldProductIds(supabaseAdmin, [rawCurrent.id])
  : new Set();
const current = rawCurrent && !soldProductIds.has(String(rawCurrent.id ?? "").trim())
  ? rawCurrent
  : null;
const currentPath = getCurrentInternalPath(Astro.url);
const providerHref = current?.user_id
  ? withReturnPath(`/proveedor-publico/${encodeURIComponent(current.user_id)}`, currentPath)
  : "";
const formatPrice = (value) => {
  const safe = Number(value ?? 0);
  return safe.toLocaleString("es-AR");
};
const formatDate = (value) => {
  if (!value) return "Sin fecha";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "Sin fecha";
  return date.toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" });
};
const formatDelivery = (value) => {
  if (!Array.isArray(value) || value.length === 0) return "No especificada";
  const labels = value.map((item) => {
    if (item === "retiro") return "Retiro";
    if (item === "envio") return "Envío";
    return item;
  });
  return labels.join(" + ");
};
const serializeDelivery = (value) =>
  Array.isArray(value) ? value.map((item) => String(item ?? "").trim().toLowerCase()).filter(Boolean).join(",") : "";
const shortId = (value) => {
  const raw = String(value ?? "").replace(/-/g, "");
  return raw ? raw.slice(0, 6).toUpperCase() : "N/A";
};
---

<MainLayout title={current?.title ? `Producto: ${current.title}` : "Producto"} backHref="/comprar">
  {current ? (
    <section class="ab-dark-panel ab-provider-products-panel">
      <p class="ab-eyebrow">Detalle de producto</p>
      <article
        class="ab-provider-product-card ab-provider-product-card--detail"
        data-user-id={current.user_id || ""}
        data-title={current.title || ""}
        data-price={current.price ?? 0}
        data-image={current.image_url || "/logo2.svg"}
        data-provider={current.seller_name || "Proveedor"}
        data-currency={current.currency || "ARS"}
        data-delivery={serializeDelivery(current.delivery_methods)}
        data-cart-id={current.id || ""}
      >
        <img
          class="ab-provider-product-card__image"
          src={current.image_url || "/logo2.svg"}
          alt={current.title || "Producto"}
          loading="lazy"
        />
        <div class="ab-provider-product-card__meta">
          <div>
            <p class="ab-provider-product-card__label">Proveedor</p>
            <p class="ab-provider-product-card__code">{current.seller_name || "Proveedor"}</p>
          </div>
          <p class="ab-provider-product-card__price">
            ${formatPrice(current.price)} <span>{current.currency || "ARS"}</span>
          </p>
        </div>
        <p class="ab-provider-product-card__code">ID {shortId(current.id)}</p>
        <h2>{current.title || "Producto sin título"}</h2>
        <p class="ab-provider-product-card__description">{current.description || "Sin descripción."}</p>
        <ul class="ab-provider-product-card__details">
          <li>Fecha: <strong>{formatDate(current.created_at)}</strong></li>
          <li>Ubicación: <strong>{current.location || "Sin especificar"}</strong></li>
          {current.pickup_address ? <li>Dirección: <strong>{current.pickup_address}</strong></li> : null}
          <li>Entrega: <strong>{formatDelivery(current.delivery_methods)}</strong></li>
        </ul>
        <div class="ab-provider-product-card__actions">
          {providerHref ? (
            <a class="ab-featured-products-provider" href={providerHref}>
              <img src="/icons/proveedor.svg" alt="" aria-hidden="true" />
              <span>Ver proveedor</span>
            </a>
          ) : null}
          <button
            type="button"
            class="ab-provider-product-card__add"
            aria-label="Enviar al carrito"
            title="Enviar al carrito"
            >
              <img src="/icons/carrito.svg" alt="" aria-hidden="true" />
              <span>Enviar al carrito</span>
            </button>
        </div>
      </article>
    </section>
  ) : (
    <section class="ab-dark-panel">
      <TitleBadge title="Producto no encontrado" icon="/icons/detalle.svg" tone="warning" />
      <p>El producto ya no está disponible o no existe.</p>
    </section>
  )}
</MainLayout>

<script>
  import "../../scripts/comprar-productos.js";
</script>

<style>
  .ab-provider-product-card--detail {
    margin: 0 auto;
    width: min(100%, 680px);
    max-width: none;
    height: auto;
    min-height: 0;
    overflow: visible;
    padding: 14px;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__image {
    height: min(320px, 42dvh);
    min-height: 220px;
    flex-basis: auto;
  }

  .ab-provider-product-card--detail h2 {
    min-height: 0;
    max-height: none;
    display: block;
    font-size: clamp(1.35rem, 5.4vw, 1.85rem);
    line-height: 1.12;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__description,
  .ab-provider-product-card--detail .ab-provider-product-card__details {
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: visible;
    display: block;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__description {
    font-size: clamp(0.98rem, 3.7vw, 1.12rem);
    line-height: 1.38;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__details {
    font-size: clamp(0.95rem, 3.5vw, 1.08rem);
    display: grid;
    gap: 4px;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__details li {
    display: block;
    line-height: 1.28;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__details strong {
    display: inline;
    margin-left: 3px;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__label {
    font-size: 11px;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__meta {
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 6px;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__meta .ab-provider-product-card__code {
    margin-top: 2px;
    color: var(--color-text);
    font-size: clamp(1.45rem, 7vw, 2.2rem);
    font-weight: 900;
    line-height: 1.08;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__price {
    flex: 0 0 auto;
    margin-left: auto;
    padding: 7px 11px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    background: var(--color-panel-tint-strong);
    font-size: clamp(1.25rem, 5.5vw, 1.75rem);
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__price span {
    font-size: 0.62em;
    font-weight: 800;
  }

  .ab-provider-product-card--detail .ab-provider-product-card__actions {
    align-items: center;
    gap: 10px;
    min-height: 0;
    flex-wrap: wrap;
  }

  .ab-provider-product-card--detail .ab-featured-products-provider,
  .ab-provider-product-card--detail .ab-provider-product-card__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1 1 180px;
    width: auto;
    max-width: none;
    height: var(--product-card-button-height);
    min-height: var(--product-card-button-height);
  }

  @media (min-width: 560px) {
    .ab-provider-product-card--detail {
      width: min(100%, 920px);
      display: grid;
      grid-template-columns: minmax(220px, 42%) minmax(0, 1fr);
      grid-template-areas:
        "image meta"
        "image code"
        "image title"
        "image description"
        "image details"
        "image actions";
      gap: 4px 16px;
      align-items: start;
      align-content: start;
    }

    .ab-provider-product-card--detail .ab-provider-product-card__image {
      grid-area: image;
      width: 100%;
      height: min(320px, 42dvh);
      min-height: 260px;
      margin: 0;
    }

    .ab-provider-product-card--detail .ab-provider-product-card__meta {
      grid-area: meta;
      margin: 0;
    }

    .ab-provider-product-card--detail .ab-provider-product-card__price {
      font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    }

    .ab-provider-product-card--detail > .ab-provider-product-card__code {
      grid-area: code;
      margin: 0;
      font-size: 13px;
    }

    .ab-provider-product-card--detail h2 {
      grid-area: title;
      margin: 0;
      align-self: start;
      font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    }

    .ab-provider-product-card--detail .ab-provider-product-card__description {
      grid-area: description;
      margin: 0;
      font-size: 15px;
    }

    .ab-provider-product-card--detail .ab-provider-product-card__details {
      grid-area: details;
      margin: 0;
      gap: 3px;
      font-size: 14px;
    }

    .ab-provider-product-card--detail .ab-provider-product-card__actions {
      grid-area: actions;
      margin-top: 8px;
      align-self: start;
    }
  }
</style>
