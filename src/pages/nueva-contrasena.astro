---
// Página: actualización de contraseña tras recuperación por email.
import MainLayout from "../layouts/MainLayout.astro";
import TitleBadge from "../components/TitleBadge.astro";
---

<MainLayout title="Nueva contraseña" backHref="/login">
  <section class="ab-dark-panel">
    <TitleBadge title="Creá una contraseña nueva" icon="/icons/licencia.svg" tone="primary" />

    <form class="ab-form" id="new-password-form" method="post">
      <label for="password">Nueva contraseña</label>
      <p class="ab-form-help" id="new-password-requirements">
        Mínimo 8 caracteres, 1 mayúscula, 1 carácter especial y 1 número.
      </p>
      <span class="ab-field-with-toggle">
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Elegí una contraseña nueva"
          autocomplete="new-password"
          required
          minlength="8"
          pattern="(?=.*[A-ZÁÉÍÓÚÑ])(?=.*[0-9])(?=.*[^A-Za-zÁÉÍÓÚÑáéíóúñ0-9]).{8,}"
          title="Mínimo 8 caracteres, 1 mayúscula, 1 carácter especial y 1 número."
          aria-describedby="new-password-requirements"
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password"
          aria-label="Mostrar contraseña"
          aria-pressed="false"
          title="Mostrar contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>

      <label for="password-confirm">Confirmar contraseña</label>
      <span class="ab-field-with-toggle">
        <input
          id="password-confirm"
          name="password-confirm"
          type="password"
          placeholder="Repetí tu contraseña"
          autocomplete="new-password"
          required
          minlength="8"
        />
        <button
          class="ab-field-visibility-toggle"
          type="button"
          data-password-visibility="password-confirm"
          aria-label="Mostrar confirmación de contraseña"
          aria-pressed="false"
          title="Mostrar confirmación de contraseña"
        >
          <img src="/icons/ojo.svg" alt="" aria-hidden="true" />
        </button>
      </span>

      <div class="ab-actions">
        <button type="submit" class="ab-cta-button" id="new-password-submit">
          <img src="/icons/licencia.svg" alt="" aria-hidden="true" />
          <span>Guardar contraseña</span>
        </button>
        <a class="ab-cta-button ab-cta-button--ghost" href="/login">
          <img src="/icons/iniciarsesion.svg" alt="" aria-hidden="true" />
          <span>Volver al login</span>
        </a>
      </div>

      <p id="new-password-feedback" class="ab-muted-text" aria-live="polite"></p>
    </form>
  </section>
</MainLayout>

<script>
  import "../scripts/new-password.js";
  import "../scripts/password-visibility.js";
</script>
