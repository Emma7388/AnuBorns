---
import MainLayout from "../../layouts/MainLayout.astro";
import TitleBadge from "../../components/TitleBadge.astro";
---

<MainLayout title="Verificando cuenta" backHref="/login">
  <section class="ab-dark-panel">
    <p class="ab-eyebrow">Verificación</p>
    <TitleBadge title="Estamos verificando tu cuenta" icon="/icons/iniciarsesion.svg" tone="primary" />
    <p id="auth-callback-feedback" class="ab-muted-text" aria-live="polite">
      Un momento, por favor...
    </p>
    <div class="ab-actions">
      <a class="ab-cta-button" href="/login">Ir a login</a>
    </div>
  </section>
</MainLayout>

<script>
  import "../../scripts/auth-callback.js";
</script>
