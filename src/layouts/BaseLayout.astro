---
// Layout base: HTML, metas, transiciones y utilidades globales.
import { ClientRouter } from "astro:transitions";

const { title = "mvp-peach-six.vercel.app" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/LogoProvisorio.jpeg" />
    <link rel="apple-touch-icon" href="/LogoProvisorio.jpeg" />
    <!-- Aplica tema antes de pintar para evitar flashes. Claro es el modo principal. -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("ab_theme");
        const theme = savedTheme === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <!-- Marca transiciones al volver del perfil -->
    <script is:inline>
      try {
        if (sessionStorage.getItem("ab_profile_enter") === "1") {
          document.documentElement.classList.add("ab-profile-enter");
        }
      } catch {
        // ignore
      }
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <!-- Script global: transiciones y utilidades internas -->
    <script is:inline>
      (() => {
        const PROFILE_ENTER_KEY = "ab_profile_enter";
        const BASE_ENHANCEMENTS_BOUND_KEY = "__abBaseEnhancementsBound";
        const NAV_GUARD_BOUND_KEY = "__abNavigationGuardBound";
        const NAV_GUARD_WINDOW_MS = 800;
        let lastNavigationHref = "";
        let lastNavigationAt = 0;

        const normalizePath = (value = "") => {
          if (value === "/") return "/";
          return value.replace(/\/+$/, "");
        };

        const isPlainPrimaryClick = (event) =>
          event.button === 0 &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.altKey &&
          !event.shiftKey;

        const shouldIgnoreLink = (link) => {
          const target = link.getAttribute("target");
          return (
            link.hasAttribute("download") ||
            link.hasAttribute("data-astro-reload") ||
            link.getAttribute("data-ab-back") === "history" ||
            (target && target !== "_self")
          );
        };

        const normalizePhoneValue = (input) => {
          const nextValue = input.value.replace(/\D+/g, "");
          if (input.value !== nextValue) input.value = nextValue;
        };

        const bindPhoneInputs = () => {
          document.querySelectorAll("[data-phone-input]").forEach((input) => {
            if (!(input instanceof HTMLInputElement)) return;
            normalizePhoneValue(input);
            if (input.dataset.abPhoneBound === "true") return;
            input.addEventListener("input", () => normalizePhoneValue(input));
            input.dataset.abPhoneBound = "true";
          });
        };

        const normalizeSubmittedPhoneInputs = (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          form.querySelectorAll("[data-phone-input]").forEach((input) => {
            if (input instanceof HTMLInputElement) normalizePhoneValue(input);
          });
        };

        const resolveInternalUrl = (link) => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("#")) return null;
          try {
            const url = new URL(href, window.location.href);
            return url.origin === window.location.origin ? url : null;
          } catch {
            return null;
          }
        };

        const guardInternalNavigation = (event) => {
          if (event.defaultPrevented || !isPlainPrimaryClick(event)) return;
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest("a[href]");
          if (!(link instanceof HTMLAnchorElement) || shouldIgnoreLink(link)) return;

          const url = resolveInternalUrl(link);
          if (!url) return;

          const currentPath = normalizePath(window.location.pathname);
          const nextPath = normalizePath(url.pathname);
          const sameDocument =
            currentPath === nextPath &&
            window.location.search === url.search &&
            window.location.hash === url.hash;
          if (sameDocument) {
            event.preventDefault();
            return;
          }

          const nextHref = `${nextPath}${url.search}${url.hash}`;
          const now = Date.now();
          if (nextHref === lastNavigationHref && now - lastNavigationAt < NAV_GUARD_WINDOW_MS) {
            event.preventDefault();
            return;
          }
          lastNavigationHref = nextHref;
          lastNavigationAt = now;
        };

        /* Detecta clicks que van al perfil para animación de entrada. */
        const markProfileEnter = (event = new MouseEvent("click")) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest("[data-ab-profile-link]");
          if (link) {
            try {
              sessionStorage.setItem(PROFILE_ENTER_KEY, "1");
            } catch {
              // ignore
            }
          }
        };

        bindPhoneInputs();

        if (!Reflect.get(window, BASE_ENHANCEMENTS_BOUND_KEY)) {
          document.addEventListener("click", markProfileEnter);
          document.addEventListener("submit", normalizeSubmittedPhoneInputs, { capture: true });
          document.addEventListener("astro:page-load", bindPhoneInputs);
          document.addEventListener("astro:after-swap", bindPhoneInputs);
          window.addEventListener("pageshow", bindPhoneInputs);
          Reflect.set(window, BASE_ENHANCEMENTS_BOUND_KEY, true);
        }

        if (!Reflect.get(window, NAV_GUARD_BOUND_KEY)) {
          document.addEventListener("click", guardInternalNavigation, { capture: true });
          Reflect.set(window, NAV_GUARD_BOUND_KEY, true);
        }

        /* Limpia la clase luego de la animación. */
        try {
          if (sessionStorage.getItem(PROFILE_ENTER_KEY) === "1") {
            sessionStorage.removeItem(PROFILE_ENTER_KEY);
            window.setTimeout(() => {
              document.documentElement.classList.remove("ab-profile-enter");
            }, 280);
          }
        } catch {
          // ignore
        }
      })();
    </script>
  </body>
</html>
