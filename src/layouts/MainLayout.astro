---
// Layout principal: header, footer y navegación de regreso.
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

// Calcula el "volver" según ruta.
const { title, backHref: customBackHref } = Astro.props;
const pathname = Astro.url.pathname;
const segments = pathname.split("/").filter(Boolean);
const backHref = customBackHref ?? (segments.length <= 1 ? "/" : `/${segments.slice(0, -1).join("/")}`);
const showBack = pathname !== "/";
---

<BaseLayout title={title}>
  <!-- Header global -->
  <Header title={title} />

  <!-- Contenido de página -->
  <main
    data-ab-page-title={title ?? ""}
    data-ab-show-back={showBack ? "true" : "false"}
    data-ab-back-href={backHref}
  >
    <slot />
  </main>

  <!-- Footer con CTA volver -->
  <Footer showBack={showBack} backHref={backHref} />

  <!-- Intercepta botón volver cuando se pide volver por history -->
  <script is:inline>
    const bindBackLinks = () => {
      const backLinks = document.querySelectorAll("[data-ab-back]");
      if (backLinks.length) {
        backLinks.forEach((link) => {
          if (link.dataset.abBackBound === "true") return;
          link.addEventListener("click", (event) => {
            if (link.getAttribute("data-ab-back") !== "history") return;
            if (window.history.length <= 1) return;
            event.preventDefault();
            window.history.back();
          });
          link.dataset.abBackBound = "true";
        });
      }
    };

    const runLayoutEnhancements = () => {
      const titleWrap = document.getElementById("ab-header-page-title");
      const main = document.querySelector("main[data-ab-page-title]");
      const pageTitle = main?.getAttribute("data-ab-page-title")?.trim() ?? "";

      if (titleWrap) {
        let heading = titleWrap.querySelector("h1");
        if (!pageTitle) {
          heading?.remove();
        } else {
          if (!heading) {
            heading = document.createElement("h1");
            titleWrap.appendChild(heading);
          }
          heading.textContent = pageTitle;
        }
      }

      const footerBack = document.getElementById("footer-back");
      if (footerBack) {
        const showBack = main?.getAttribute("data-ab-show-back") === "true";
        const backHref = main?.getAttribute("data-ab-back-href") || "/";
        const useHistoryBack = backHref === "history";
        footerBack.hidden = !showBack;
        footerBack.setAttribute("aria-hidden", showBack ? "false" : "true");
        footerBack.setAttribute("tabindex", showBack ? "0" : "-1");
        footerBack.setAttribute("href", useHistoryBack ? "/" : backHref);
        footerBack.setAttribute("data-ab-back", useHistoryBack ? "history" : "link");
        footerBack.removeAttribute("data-astro-reload");
      }

      bindBackLinks();
    };

    runLayoutEnhancements();

    if (!window.__abLayoutEnhancementsBound) {
      document.addEventListener("astro:page-load", runLayoutEnhancements);
      document.addEventListener("astro:after-swap", runLayoutEnhancements);
      window.addEventListener("pageshow", runLayoutEnhancements);
      window.__abLayoutEnhancementsBound = true;
    }
  </script>

  <script>
    import "../scripts/product-image-modal.js";
  </script>
</BaseLayout>
